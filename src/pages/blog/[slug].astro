      var(--color-primary-500),
      var(--color-secondary-500)
    );
    transform-origin: left;
    transform: scaleX(0);
    z-index: 9999;
    box-shadow: 0 0 10px rgba(236, 72, 153, 0.5);
  }
  
  .container-narrow {
    max-width: 720px;
    margin: 0 auto;
    padding: 0 2rem;
  }
  
  /* Article Header */
  .article-header {
    padding: calc(80px + 5rem) 0 4rem;
    background: linear-gradient(135deg, 
      rgba(168, 85, 247, 0.12) 0%,
      rgba(219, 39, 119, 0.12) 50%,
      rgba(249, 115, 22, 0.08) 100%
    );
    position: relative;
  }
  
  .article-header::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 50% 50%, rgba(236, 72, 153, 0.08) 0%, transparent 70%);
    pointer-events: none;
  }
  
  [data-theme="dark"] .article-header {
    background: linear-gradient(135deg, 
      rgba(88, 28, 135, 0.25) 0%,
      rgba(136, 19, 55, 0.25) 50%,
      rgba(154, 52, 18, 0.18) 100%
    );
  }
  
  [data-theme="dark"] .article-header::before {
    background: radial-gradient(circle at 50% 50%, rgba(236, 72, 153, 0.12) 0%, transparent 70%);
  }
  
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    color: var(--text-secondary);
    text-decoration: none;
    font-weight: 600;
    font-size: 1rem;
    margin-bottom: 3rem;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
  }
  
  .back-link::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 2px;
    background: linear-gradient(90deg, 
      var(--color-primary-500),
      var(--color-secondary-500)
    );
    transition: width 0.3s ease;
  }
  
  .back-link:hover {
    color: var(--color-primary-600);
    gap: 0.875rem;
  }
  
  .back-link:hover::after {
    width: 100%;
