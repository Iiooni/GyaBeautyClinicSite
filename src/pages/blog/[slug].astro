const { slug } = Astro.params;
const article = blogPostsData[slug as keyof typeof blogPostsData];

// Get related posts (exclude current article)
const allSlugs = Object.keys(blogPostsData).filter(s => s !== slug);
const relatedSlugs = allSlugs.slice(0, 3);
