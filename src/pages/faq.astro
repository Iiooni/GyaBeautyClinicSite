---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';

const faqCategories = [
  {
    id: 'general',
    title: 'General Questions',
    icon: '❓',
    faqs: [
      {
        question: 'What are your operating hours?',
        answer: 'We are open Monday to Friday from 9:00 AM to 6:00 PM, and Saturday from 10:00 AM to 4:00 PM. We are closed on Sundays and major holidays.'
      },
      {
        question: 'Do I need an appointment?',
        answer: 'Yes, we operate by appointment only to ensure you receive our full attention and personalized care. Walk-ins are accommodated when possible, but we recommend booking in advance.'
      },
      {
        question: 'What should I bring to my first appointment?',
        answer: 'Please bring a valid ID, insurance information if applicable, and a list of any medications or skincare products you currently use. Arrive 10 minutes early to complete paperwork.'
      },
      {
        question: 'Do you offer virtual consultations?',
        answer: 'Yes, we offer virtual consultations for initial assessments and follow-up appointments. Contact us to schedule a video consultation with our specialists.'
      }
    ]
  },
  {
    id: 'treatments',
    title: 'Treatment Questions',
    icon: '💉',
    faqs: [
      {
        question: 'How do I choose the right treatment?',
        answer: 'During your consultation, our specialists will assess your skin, discuss your concerns and goals, and recommend the most suitable treatments. We create personalized treatment plans tailored to your needs.'
      },
      {
        question: 'Are treatments painful?',
        answer: 'Most treatments involve minimal discomfort. We use numbing creams, ice, and other comfort measures. Our team ensures you are comfortable throughout your treatment.'
      },
      {
        question: 'How long do treatments take?',
        answer: 'Treatment duration varies by procedure. Quick treatments like Botox take 15-30 minutes, while comprehensive facials or body treatments may take 60-90 minutes. We provide estimated times during booking.'
      },
      {
        question: 'When will I see results?',
        answer: 'Results timing varies by treatment. Injectables show results within days to 2 weeks, laser treatments in 2-4 weeks, and skincare treatments may require multiple sessions for optimal results.'
      }
    ]
  },
  {
    id: 'booking',
    title: 'Booking & Payment',
    icon: '📅',
    faqs: [
      {
        question: 'How do I book an appointment?',
        answer: 'You can book online through our website, call us at +1 (234) 567-8900, or email info@beautyclinic.com. We recommend booking 1-2 weeks in advance for popular treatments.'
      },
      {
        question: 'What is your cancellation policy?',
        answer: 'We require 24 hours notice for cancellations or rescheduling. Late cancellations or no-shows may incur a fee. Please contact us as soon as possible if you need to change your appointment.'
      },
      {
        question: 'What payment methods do you accept?',
        answer: 'We accept cash, all major credit cards (Visa, Mastercard, American Express), and debit cards. Payment is due at the time of service unless other arrangements have been made.'
      },
      {
        question: 'Do you offer payment plans?',
        answer: 'Yes, we offer flexible payment plans for treatments over $500. Contact our office to discuss financing options and create a payment plan that works for your budget.'
      }
    ]
  },
  {
    id: 'safety',
    title: 'Safety & Aftercare',
    icon: '🛡️',
    faqs: [
      {
        question: 'Are your treatments safe?',
        answer: 'Yes, all our treatments are performed by licensed professionals using FDA-approved products and equipment. We follow strict safety protocols and hygiene standards.'
      },
      {
        question: 'What should I do after treatment?',
        answer: 'We provide detailed aftercare instructions specific to your treatment. Generally, avoid sun exposure, follow skincare routines as directed, and contact us with any concerns.'
      },
      {
        question: 'Are there any side effects?',
        answer: 'Most treatments have minimal side effects like temporary redness or swelling. We discuss potential side effects during consultation and provide guidance on managing them.'
      },
      {
        question: 'Can I combine multiple treatments?',
        answer: 'Yes, many treatments can be combined for enhanced results. Our specialists will create a comprehensive treatment plan and advise on safe combinations and timing.'
      }
    ]
  },
  {
    id: 'products',
    title: 'Products & Skincare',
    icon: '🧴',
    faqs: [
      {
        question: 'Do you sell skincare products?',
        answer: 'Yes, we offer professional-grade skincare products recommended by our specialists. These products complement your treatments and help maintain results at home.'
      },
      {
        question: 'Can I use my own skincare products?',
        answer: 'We recommend discussing your current products with our specialists. Some products may interfere with treatments or not be suitable for your skin type.'
      },
      {
        question: 'Do you offer product consultations?',
        answer: 'Yes, we provide complimentary skincare consultations to help you build an effective home care routine that supports your treatment results.'
      },
      {
        question: 'What brands do you carry?',
        answer: 'We carry premium medical-grade brands selected for their efficacy and safety. Our specialists will recommend specific products based on your skin needs.'
      }
    ]
  }
];
---

<BaseLayout 
  title="FAQ - Beauty Clinic"
  description="Frequently asked questions about our treatments, booking, safety, and more. Find answers to common questions about Beauty Clinic services."
>
  <Header />
  
  <main>
    <!-- Hero Section -->
    <section class="faq-hero">
      <div class="container">
        <div class="hero-content">
          <div class="hero-badge">Help Center</div>
          <h1 class="hero-title">Frequently Asked Questions</h1>
          <p class="hero-description">
            Find answers to common questions about our services, treatments, and policies
          </p>
        </div>
      </div>
    </section>

    <!-- FAQ Categories Section -->
    <section class="faq-section">
      <div class="container">
        {faqCategories.map((category, catIndex) => (
          <div class={`faq-category reveal stagger-${(catIndex % 2) + 1}`}>
            <div class="category-header">
              <div class="category-icon">{category.icon}</div>
              <h2 class="category-title">{category.title}</h2>
            </div>
            
            <div class="faq-list">
              {category.faqs.map((faq, faqIndex) => (
                <div class="faq-item card">
                  <button class="faq-question" data-faq={`${category.id}-${faqIndex}`}>
                    <span class="question-text">{faq.question}</span>
                    <svg class="faq-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <line x1="12" y1="5" x2="12" y2="19"></line>
                      <line x1="5" y1="12" x2="19" y2="12"></line>
                    </svg>
                  </button>
                  <div class="faq-answer">
                    <p>{faq.answer}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Contact CTA Section -->
    <section class="faq-cta-section">
      <div class="container">
        <div class="cta-content">
          <h2 class="cta-title">Still Have Questions?</h2>
          <p class="cta-description">
            Our team is here to help. Contact us for personalized assistance.
          </p>
          <div class="cta-actions">
            <a href="/contact" class="btn btn-primary btn-large">
              Contact Us
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
            <a href="/booking" class="btn btn-secondary btn-large">
              Book Appointment
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
  
  <Footer />
</BaseLayout>


<style>
  /* ===== HERO SECTION ===== */
  .faq-hero {
    padding: calc(80px + 5rem) 0 4rem;
    background: 
      linear-gradient(to bottom, 
        transparent 0%,
        transparent 70%,
        rgba(0, 0, 0, 0.03) 100%
      ),
      linear-gradient(135deg, 
        rgba(168, 85, 247, 0.15) 0%,
        rgba(219, 39, 119, 0.15) 50%,
        rgba(249, 115, 22, 0.12) 100%
      );
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  
  .faq-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: 
      radial-gradient(ellipse at 50% 20%, rgba(236, 72, 153, 0.12) 0%, transparent 40%),
      radial-gradient(ellipse at 50% 100%, rgba(236, 72, 153, 0.08) 0%, transparent 50%),
      radial-gradient(circle at 50% 50%, rgba(236, 72, 153, 0.15) 0%, transparent 70%),
      url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ec4899' fill-opacity='0.015'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
    pointer-events: none;
    animation: pulse 4s ease-in-out infinite;
  }
  
  @keyframes pulse {
    0%, 100% { opacity: 0.5; }
    50% { opacity: 1; }
  }
  
  .faq-hero::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, 
      transparent 0%,
      rgba(236, 72, 153, 0.3) 50%,
      transparent 100%
    );
    box-shadow: 0 4px 12px rgba(236, 72, 153, 0.15);
  }

  [data-theme="dark"] .faq-hero {
    background: 
      linear-gradient(to bottom, 
        transparent 0%,
        transparent 70%,
        rgba(0, 0, 0, 0.2) 100%
      ),
      linear-gradient(135deg, 
        rgba(88, 28, 135, 0.4) 0%,
        rgba(136, 19, 55, 0.4) 50%,
        rgba(154, 52, 18, 0.3) 100%
      );
  }
  
  [data-theme="dark"] .faq-hero::before {
    background: 
      radial-gradient(ellipse at 50% 20%, rgba(236, 72, 153, 0.18) 0%, transparent 40%),
      radial-gradient(ellipse at 50% 100%, rgba(236, 72, 153, 0.12) 0%, transparent 50%),
      radial-gradient(circle at 50% 50%, rgba(236, 72, 153, 0.2) 0%, transparent 70%),
      url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ec4899' fill-opacity='0.02'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
  }
  
  [data-theme="dark"] .faq-hero::after {
    background: linear-gradient(90deg, 
      transparent 0%,
      rgba(236, 72, 153, 0.4) 50%,
      transparent 100%
    );
    box-shadow: 0 4px 12px rgba(236, 72, 153, 0.2);
  }
  
  .hero-content {
    max-width: 900px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }
  
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.625rem 1.25rem;
    background: linear-gradient(135deg, rgba(236, 72, 153, 0.15), rgba(219, 39, 119, 0.15));
    border: 1.5px solid rgba(236, 72, 153, 0.3);
    border-radius: 999px;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-primary-600);
    margin-bottom: 2rem;
    box-shadow: 0 4px 12px rgba(236, 72, 153, 0.2);
  }
  
  [data-theme="dark"] .hero-badge {
    background: linear-gradient(135deg, rgba(236, 72, 153, 0.25), rgba(219, 39, 119, 0.25));
    border-color: rgba(236, 72, 153, 0.4);
    color: rgba(236, 72, 153, 0.95);
  }
  
  .hero-title {
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    margin-bottom: 1.5rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }
  
  .hero-description {
    font-size: clamp(1.125rem, 2vw, 1.375rem);
    color: var(--text-secondary);
    opacity: 0.9;
    max-width: 700px;
    margin: 0 auto;
    line-height: 1.6;
  }

  /* ===== FAQ SECTION ===== */
  .faq-section {
    background: var(--bg-primary);
    padding: 6rem 0 8rem;
    position: relative;
  }
  
  .faq-section::before {
    content: '';
    position: absolute;
    inset: 0;
    background: 
      radial-gradient(ellipse at 30% 50%, rgba(236, 72, 153, 0.03) 0%, transparent 50%),
      radial-gradient(ellipse at 70% 50%, rgba(139, 92, 246, 0.03) 0%, transparent 50%),
      url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ec4899' fill-opacity='0.015'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
    pointer-events: none;
  }
  
  [data-theme="dark"] .faq-section::before {
    background: 
      radial-gradient(ellipse at 30% 50%, rgba(236, 72, 153, 0.05) 0%, transparent 50%),
      radial-gradient(ellipse at 70% 50%, rgba(139, 92, 246, 0.05) 0%, transparent 50%),
      url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ec4899' fill-opacity='0.02'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
  }
  
  .faq-category {
    margin-bottom: 4rem;
    position: relative;
    z-index: 1;
  }
  
  .faq-category:last-child {
    margin-bottom: 0;
  }
  
  .category-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 2rem;
  }
  
  .category-icon {
    font-size: 2.5rem;
    filter: drop-shadow(0 4px 12px rgba(236, 72, 153, 0.25));
  }
  
  .category-title {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--text-primary);
  }
  
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .faq-item {
    background: var(--bg-secondary);
    border-radius: var(--radius-xl);
    border: 1.5px solid rgba(236, 72, 153, 0.12);
    overflow: hidden;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 
      var(--shadow-sm),
      0 0 20px rgba(236, 72, 153, 0.05);
  }
  
  .faq-item:hover {
    border-color: rgba(236, 72, 153, 0.25);
    box-shadow: 
      var(--shadow-md),
      0 0 30px rgba(236, 72, 153, 0.1);
  }
  
  [data-theme="dark"] .faq-item {
    background: rgba(18, 18, 26, 0.8);
    backdrop-filter: blur(8px);
    border-color: rgba(236, 72, 153, 0.18);
  }
  
  .faq-question {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.75rem 2rem;
    background: transparent;
    border: none;
    cursor: pointer;
    text-align: left;
    transition: all 0.3s ease;
  }
  
  .faq-question:hover {
    background: rgba(236, 72, 153, 0.04);
  }
  
  [data-theme="dark"] .faq-question:hover {
    background: rgba(236, 72, 153, 0.08);
  }
  
  .question-text {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.5;
  }
  
  .faq-icon {
    flex-shrink: 0;
    color: var(--color-primary-500);
    transition: transform 0.3s ease;
  }
  
  .faq-item.active .faq-icon {
    transform: rotate(45deg);
  }
  
  .faq-answer {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease, padding 0.3s ease;
  }
  
  .faq-item.active .faq-answer {
    max-height: 500px;
    padding: 0 2rem 1.75rem;
  }
  
  .faq-answer p {
    color: var(--text-secondary);
    opacity: 0.9;
    line-height: 1.7;
    font-size: 1rem;
    margin: 0;
  }

  /* ===== CTA SECTION ===== */
  .faq-cta-section {
    background: linear-gradient(135deg, 
      rgba(236, 72, 153, 0.08),
      rgba(139, 92, 246, 0.08)
    );
    padding: 6rem 0;
    position: relative;
    overflow: hidden;
  }
  
  .faq-cta-section::before {
    content: '';
    position: absolute;
    inset: 0;
    background: 
      radial-gradient(circle at 50% 50%, rgba(236, 72, 153, 0.1) 0%, transparent 70%),
      url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ec4899' fill-opacity='0.02'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
    pointer-events: none;
  }
  
  [data-theme="dark"] .faq-cta-section {
    background: linear-gradient(135deg, 
      rgba(236, 72, 153, 0.12),
      rgba(139, 92, 246, 0.12)
    );
  }
  
  .cta-content {
    text-align: center;
    max-width: 800px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }
  
  .cta-title {
    font-size: clamp(2rem, 4vw, 3rem);
    margin-bottom: 1rem;
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  
  .cta-description {
    font-size: 1.125rem;
    color: var(--text-secondary);
    opacity: 0.9;
    margin-bottom: 2.5rem;
    line-height: 1.7;
  }
  
  .cta-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }
  
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 1rem 2rem;
    border-radius: var(--radius-lg);
    font-weight: 600;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    cursor: pointer;
    text-decoration: none;
    border: none;
    font-family: var(--font-primary);
  }

  .btn-primary {
    background: linear-gradient(135deg, 
      rgba(236, 72, 153, 0.95),
      rgba(219, 39, 119, 0.95)
    );
    color: white;
    box-shadow: 
      0 4px 16px rgba(236, 72, 153, 0.4),
      0 0 30px rgba(236, 72, 153, 0.25);
    position: relative;
    overflow: hidden;
  }
  
  .btn-primary::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, 
      rgba(255, 255, 255, 0.15),
      transparent
    );
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  
  .btn-primary:hover {
    transform: translateY(-3px);
    box-shadow: 
      0 6px 24px rgba(236, 72, 153, 0.5),
      0 0 40px rgba(236, 72, 153, 0.35);
  }
  
  .btn-primary:hover::before {
    opacity: 1;
  }
  
  .btn-secondary {
    background: transparent;
    color: var(--color-primary-600);
    border: 1.5px solid rgba(236, 72, 153, 0.3);
    box-shadow: 0 2px 8px rgba(236, 72, 153, 0.1);
  }
  
  .btn-secondary:hover {
    background: rgba(236, 72, 153, 0.1);
    border-color: rgba(236, 72, 153, 0.5);
    transform: translateY(-3px);
    box-shadow: 0 4px 16px rgba(236, 72, 153, 0.2);
  }
  
  [data-theme="dark"] .btn-secondary {
    color: rgba(236, 72, 153, 0.95);
    border-color: rgba(236, 72, 153, 0.4);
  }
  
  [data-theme="dark"] .btn-secondary:hover {
    background: rgba(236, 72, 153, 0.15);
    border-color: rgba(236, 72, 153, 0.6);
  }
  
  .btn-large {
    padding: 1.125rem 2.5rem;
    font-size: 1.0625rem;
  }
  
  .btn svg {
    transition: transform 0.3s ease;
  }
  
  .btn:hover svg {
    transform: translateX(3px);
  }
  
  /* Responsive */
  @media (max-width: 768px) {
    .faq-hero {
      padding: calc(80px + 4rem) 0 3rem;
    }
    
    .faq-section {
      padding: 4rem 0 6rem;
    }
    
    .faq-cta-section {
      padding: 4rem 0;
    }
    
    .category-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
    }
    
    .faq-question {
      padding: 1.25rem 1.5rem;
    }
    
    .faq-item.active .faq-answer {
      padding: 0 1.5rem 1.25rem;
    }
    
    .cta-actions {
      flex-direction: column;
      align-items: stretch;
    }
    
    .btn-large {
      width: 100%;
    }
  }
</style>


<script>
  // FAQ Accordion functionality
  document.addEventListener('DOMContentLoaded', () => {
    const faqQuestions = document.querySelectorAll('.faq-question');
    
    faqQuestions.forEach(question => {
      question.addEventListener('click', () => {
        const faqItem = question.closest('.faq-item');
        if (!faqItem) return;
        
        const isActive = faqItem.classList.contains('active');
        
        // Close all other FAQ items in the same category
        const category = faqItem.closest('.faq-category');
        if (category) {
          const allItems = category.querySelectorAll('.faq-item');
          allItems.forEach(item => {
            if (item !== faqItem) {
              item.classList.remove('active');
            }
          });
        }
        
        // Toggle current item
        faqItem.classList.toggle('active', !isActive);
      });
    });
  });
</script>
