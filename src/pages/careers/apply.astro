<script>
  // File upload handling
  const fileInputs = document.querySelectorAll('input[type="file"]');
  
  fileInputs.forEach(input => {
    input.addEventListener('change', (e) => {
      const target = e.target as HTMLInputElement;
      const wrapper = target.closest('.file-input-wrapper');
      const fileNameDisplay = wrapper?.querySelector('.file-name');
      
      if (target.files && target.files.length > 0) {
        const fileName = target.files[0].name;
        if (fileNameDisplay) {
          fileNameDisplay.textContent = fileName;
        }
        wrapper?.classList.add('has-file');
      } else {
        if (fileNameDisplay) {
          fileNameDisplay.textContent = '';
        }
        wrapper?.classList.remove('has-file');
      }
    });
  });
  
  // Form submission
  const form = document.getElementById('applicationForm') as HTMLFormElement;
  
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    
    const formData = new FormData(form);
    const data = Object.fromEntries(formData.entries());
    
    // Here you would typically send the data to your backend
    console.log('Application data:', data);
    
    alert('Thank you for your application! We will review it and get back to you within 5 business days.');
    form.reset();
    
    // Reset file upload displays
    document.querySelectorAll('.file-input-wrapper').forEach(wrapper => {
      wrapper.classList.remove('has-file');
      const fileNameDisplay = wrapper.querySelector('.file-name');
      if (fileNameDisplay) {
        fileNameDisplay.textContent = '';
      }
    });
  });
</script>
