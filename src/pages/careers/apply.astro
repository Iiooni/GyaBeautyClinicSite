---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';

// Get job ID from URL params
const url = new URL(Astro.request.url);
const jobId = url.searchParams.get('job') || 'general';

// Job data (same as careers page)
const jobsData: Record<string, any> = {
  'senior-aesthetician': {
    title: 'Senior Aesthetician',
    department: 'Clinical',
    location: 'New York, NY',
    type: 'Full-time',
    experience: '5+ years'
  },
  'laser-technician': {
    title: 'Laser Technician',
    department: 'Clinical',
    location: 'New York, NY',
    type: 'Full-time',
    experience: '3+ years'
  },
  'front-desk-coordinator': {
    title: 'Front Desk Coordinator',
    department: 'Operations',
    location: 'New York, NY',
    type: 'Full-time',
    experience: '2+ years'
  },
  'marketing-manager': {
    title: 'Marketing Manager',
    department: 'Marketing',
    location: 'New York, NY',
    type: 'Full-time',
    experience: '4+ years'
  },
  'nurse-practitioner': {
    title: 'Nurse Practitioner',
    department: 'Clinical',
    location: 'New York, NY',
    type: 'Full-time',
    experience: '3+ years'
  },
  'spa-manager': {
    title: 'Spa Manager',
    department: 'Operations',
    location: 'New York, NY',
    type: 'Full-time',
    experience: '5+ years'
  }
};

const job = jobsData[jobId] || {
  title: 'General Application',
  department: 'Various',
  location: 'New York, NY',
  type: 'Full-time',
  experience: 'Varies'
};

const applicationTips = [
  {
    icon: '📝',
    title: 'Complete All Fields',
    description: 'Ensure all required information is provided accurately'
  },
  {
    icon: '📄',
    title: 'Update Your Resume',
    description: 'Upload your most recent resume in PDF format'
  },
  {
    icon: '✍️',
    title: 'Personalize Your Cover Letter',
    description: 'Explain why you\'re perfect for this specific role'
  },
  {
    icon: '🔍',
    title: 'Review Before Submitting',
    description: 'Double-check all information for accuracy'
  }
];

const benefits = [
  'Competitive salary and bonuses',
  'Comprehensive health insurance',
  'Professional development opportunities',
  'Employee treatment discounts',
  'Paid time off and holidays',
  'Supportive team environment'
];
---

<BaseLayout 
  title={`Apply for ${job.title} - Beauty Clinic`}
  description={`Submit your application for the ${job.title} position at our premium beauty clinic. Join our team of passionate professionals.`}
>
  <Header />
  
  <main>
    <!-- Hero Section -->
    <section class="apply-hero">
      <div class="container">
        <div class="hero-content">
          <a href="/careers" class="back-link">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="19" y1="12" x2="5" y2="12"></line>
              <polyline points="12 19 5 12 12 5"></polyline>
            </svg>
            Back to Careers
          </a>
          <h1 class="hero-title">Apply for {job.title}</h1>
          <div class="job-meta">
            <span class="meta-item">{job.department}</span>
            <span class="meta-divider">•</span>
            <span class="meta-item">{job.location}</span>
            <span class="meta-divider">•</span>
            <span class="meta-item">{job.type}</span>
            <span class="meta-divider">•</span>
            <span class="meta-item">{job.experience}</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Application Form Section -->
    <section class="application-section">
      <div class="container">
        <div class="application-grid">
          <!-- Application Form -->
          <div class="form-wrapper">
            <div class="form-card card">
              <h2 class="form-title">Application Form</h2>
              <p class="form-description">
                Please fill out all required fields. We'll review your application and get back to you within 5 business days.
              </p>
              
              <form class="application-form" id="applicationForm">
                <!-- Personal Information -->
                <div class="form-section">
                  <h3 class="section-title">Personal Information</h3>
                  
                  <div class="form-row">
                    <div class="form-group">
                      <label for="firstName">First Name *</label>
                      <input 
                        type="text" 
                        id="firstName" 
                        name="firstName" 
                        required
                        placeholder="John"
                      />
                    </div>
                    
                    <div class="form-group">
                      <label for="lastName">Last Name *</label>
                      <input 
                        type="text" 
                        id="lastName" 
                        name="lastName" 
                        required
                        placeholder="Doe"
                      />
                    </div>
                  </div>
                  
                  <div class="form-row">
                    <div class="form-group">
                      <label for="email">Email Address *</label>
                      <input 
                        type="email" 
                        id="email" 
                        name="email" 
                        required
                        placeholder="john@example.com"
                      />
                    </div>
                    
                    <div class="form-group">
                      <label for="phone">Phone Number *</label>
                      <input 
                        type="tel" 
                        id="phone" 
                        name="phone"
                        required
                        placeholder="+1 (234) 567-8900"
                      />
                    </div>
                  </div>
                  
                  <div class="form-group">
                    <label for="linkedin">LinkedIn Profile (Optional)</label>
                    <input 
                      type="url" 
                      id="linkedin" 
                      name="linkedin"
                      placeholder="https://linkedin.com/in/yourprofile"
                    />
                  </div>
                </div>
                
                <!-- Professional Information -->
                <div class="form-section">
                  <h3 class="section-title">Professional Information</h3>
                  
                  <div class="form-group">
                    <label for="position">Position Applied For *</label>
                    <input 
                      type="text" 
                      id="position" 
                      name="position" 
                      value={job.title}
                      readonly
                    />
                  </div>
                  
                  <div class="form-row">
                    <div class="form-group">
                      <label for="experience">Years of Experience *</label>
                      <select id="experience" name="experience" required>
                        <option value="">Select experience</option>
                        <option value="0-1">0-1 years</option>
                        <option value="1-3">1-3 years</option>
                        <option value="3-5">3-5 years</option>
                        <option value="5-10">5-10 years</option>
                        <option value="10+">10+ years</option>
                      </select>
                    </div>
                    
                    <div class="form-group">
                      <label for="availability">Availability *</label>
                      <select id="availability" name="availability" required>
                        <option value="">Select availability</option>
                        <option value="immediate">Immediate</option>
                        <option value="2-weeks">2 weeks notice</option>
                        <option value="1-month">1 month notice</option>
                        <option value="flexible">Flexible</option>
                      </select>
                    </div>
                  </div>
                  
                  <div class="form-group">
                    <label for="currentCompany">Current/Most Recent Company</label>
                    <input 
                      type="text" 
                      id="currentCompany" 
                      name="currentCompany"
                      placeholder="Company name"
                    />
                  </div>
                  
                  <div class="form-group">
                    <label for="currentRole">Current/Most Recent Role</label>
                    <input 
                      type="text" 
                      id="currentRole" 
                      name="currentRole"
                      placeholder="Your role/title"
                    />
                  </div>
                </div>
                
                <!-- Documents -->
                <div class="form-section">
                  <h3 class="section-title">Documents</h3>
                  
                  <div class="form-group">
                    <label for="resume">Resume/CV * (PDF, DOC, DOCX - Max 5MB)</label>
                    <div class="file-input-wrapper">
                      <input 
                        type="file" 
                        id="resume" 
                        name="resume" 
                        accept=".pdf,.doc,.docx"
                        required
                      />
                      <div class="file-input-display">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                          <polyline points="17 8 12 3 7 8"></polyline>
                          <line x1="12" y1="3" x2="12" y2="15"></line>
                        </svg>
                        <span class="file-text">Choose file or drag here</span>
                        <span class="file-name"></span>
                      </div>
                    </div>
                  </div>
                  
                  <div class="form-group">
                    <label for="coverLetter">Cover Letter (Optional - PDF, DOC, DOCX - Max 5MB)</label>
                    <div class="file-input-wrapper">
                      <input 
                        type="file" 
                        id="coverLetter" 
                        name="coverLetter" 
                        accept=".pdf,.doc,.docx"
                      />
                      <div class="file-input-display">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                          <polyline points="17 8 12 3 7 8"></polyline>
                          <line x1="12" y1="3" x2="12" y2="15"></line>
                        </svg>
                        <span class="file-text">Choose file or drag here</span>
                        <span class="file-name"></span>
                      </div>
                    </div>
                  </div>
                </div>
                
                <!-- Additional Information -->
                <div class="form-section">
                  <h3 class="section-title">Additional Information</h3>
                  
                  <div class="form-group">
                    <label for="message">Why are you interested in this position? *</label>
                    <textarea 
                      id="message" 
                      name="message" 
                      rows="6" 
                      required
                      placeholder="Tell us what excites you about this opportunity and why you'd be a great fit..."
                    ></textarea>
                  </div>
                  
                  <div class="form-group">
                    <label for="salary">Expected Salary Range (Optional)</label>
                    <input 
                      type="text" 
                      id="salary" 
                      name="salary"
                      placeholder="e.g., $60,000 - $80,000"
                    />
                  </div>
                  
                  <div class="form-group checkbox-group">
                    <label class="checkbox-label">
                      <input type="checkbox" name="authorized" id="authorized" required />
                      <span>I am authorized to work in the United States *</span>
                    </label>
                  </div>
                  
                  <div class="form-group checkbox-group">
                    <label class="checkbox-label">
                      <input type="checkbox" name="consent" id="consent" required />
                      <span>I consent to the processing of my personal data for recruitment purposes *</span>
                    </label>
                  </div>
                </div>
                
                <button type="submit" class="btn btn-primary btn-large">
                  Submit Application
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                </button>
              </form>
            </div>
          </div>
          
          <!-- Sidebar -->
          <div class="sidebar">
            <!-- Application Tips -->
            <div class="sidebar-card card">
              <h3 class="sidebar-title">Application Tips</h3>
              <div class="tips-list">
                {applicationTips.map(tip => (
                  <div class="tip-item">
                    <div class="tip-icon">{tip.icon}</div>
                    <div class="tip-content">
                      <h4 class="tip-title">{tip.title}</h4>
                      <p class="tip-description">{tip.description}</p>
                    </div>
                  </div>
                ))}
              </div>
            </div>
            
            <!-- Benefits -->
            <div class="sidebar-card card">
              <h3 class="sidebar-title">What We Offer</h3>
              <ul class="benefits-list">
                {benefits.map(benefit => (
                  <li class="benefit-item">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                    {benefit}
                  </li>
                ))}
              </ul>
            </div>
            
            <!-- Contact -->
            <div class="sidebar-card card">
              <h3 class="sidebar-title">Questions?</h3>
              <p class="contact-text">
                If you have any questions about the application process, feel free to reach out.
              </p>
              <div class="contact-info">
                <div class="contact-item">
                  <span class="contact-icon">📧</span>
                  <span>careers@beautyclinic.com</span>
                </div>
                <div class="contact-item">
                  <span class="contact-icon">📞</span>
                  <span>+1 (234) 567-8900</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
  
  <Footer />
</BaseLayout>

<style>
  /* ===== HERO SECTION ===== */
  .apply-hero {
    padding: calc(80px + 5rem) 0 4rem;
    background: 
      linear-gradient(to bottom, 
        transparent 0%,
        transparent 70%,
        rgba(0, 0, 0, 0.03) 100%
      ),
      linear-gradient(135deg, 
        rgba(168, 85, 247, 0.15) 0%,
        rgba(219, 39, 119, 0.15) 50%,
        rgba(249, 115, 22, 0.12) 100%
      );
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  
  .apply-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: 
      radial-gradient(ellipse at 50% 20%, rgba(236, 72, 153, 0.12) 0%, transparent 40%),
      radial-gradient(ellipse at 50% 100%, rgba(236, 72, 153, 0.08) 0%, transparent 50%),
      radial-gradient(circle at 50% 50%, rgba(236, 72, 153, 0.15) 0%, transparent 70%),
      url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ec4899' fill-opacity='0.015'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
    pointer-events: none;
    animation: pulse 4s ease-in-out infinite;
  }
  
  @keyframes pulse {
    0%, 100% { opacity: 0.5; }
    50% { opacity: 1; }
  }
  
  .apply-hero::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, 
      transparent 0%,
      rgba(236, 72, 153, 0.3) 50%,
      transparent 100%
    );
    box-shadow: 0 4px 12px rgba(236, 72, 153, 0.15);
  }
  
  [data-theme="dark"] .apply-hero {
    background: 
      linear-gradient(to bottom, 
        transparent 0%,
        transparent 70%,
        rgba(0, 0, 0, 0.2) 100%
      ),
      linear-gradient(135deg, 
        rgba(88, 28, 135, 0.4) 0%,
        rgba(136, 19, 55, 0.4) 50%,
        rgba(154, 52, 18, 0.3) 100%
      );
  }
  
  [data-theme="dark"] .apply-hero::before {
    background: 
      radial-gradient(ellipse at 50% 20%, rgba(236, 72, 153, 0.18) 0%, transparent 40%),
      radial-gradient(ellipse at 50% 100%, rgba(236, 72, 153, 0.12) 0%, transparent 50%),
      radial-gradient(circle at 50% 50%, rgba(236, 72, 153, 0.2) 0%, transparent 70%),
      url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ec4899' fill-opacity='0.02'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
  }
  
  [data-theme="dark"] .apply-hero::after {
    background: linear-gradient(90deg, 
      transparent 0%,
      rgba(236, 72, 153, 0.4) 50%,
      transparent 100%
    );
    box-shadow: 0 4px 12px rgba(236, 72, 153, 0.2);
  }
  
  .hero-content {
    max-width: 900px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }
  
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text-secondary);
    font-size: 0.9375rem;
    font-weight: 500;
    margin-bottom: 2rem;
    transition: all 0.3s ease;
    text-decoration: none;
  }
  
  .back-link:hover {
    color: var(--color-primary-600);
    transform: translateX(-4px);
  }
  
  .back-link:hover svg {
    transform: translateX(-2px);
  }
  
  .back-link svg {
    transition: transform 0.3s ease;
  }
  
  [data-theme="dark"] .back-link:hover {
    color: rgba(236, 72, 153, 0.95);
  }
  
  .hero-title {
    font-size: clamp(2rem, 4vw, 3.5rem);
    margin-bottom: 1.5rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }
  
  .job-meta {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    font-size: 1rem;
    color: var(--text-secondary);
    opacity: 0.9;
  }
  
  .meta-item {
    font-weight: 500;
  }
  
  .meta-divider {
    opacity: 0.5;
  }

  /* ===== APPLICATION SECTION ===== */
  .application-section {
    background: var(--bg-primary);
    padding: 6rem 0 8rem;
    position: relative;
  }
  
  .application-section::before {
    content: '';
    position: absolute;
    inset: 0;
    background: 
      radial-gradient(ellipse at 30% 50%, rgba(236, 72, 153, 0.03) 0%, transparent 50%),
      radial-gradient(ellipse at 70% 50%, rgba(139, 92, 246, 0.03) 0%, transparent 50%),
      url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ec4899' fill-opacity='0.015'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
    pointer-events: none;
  }
  
  [data-theme="dark"] .application-section::before {
    background: 
      radial-gradient(ellipse at 30% 50%, rgba(236, 72, 153, 0.05) 0%, transparent 50%),
      radial-gradient(ellipse at 70% 50%, rgba(139, 92, 246, 0.05) 0%, transparent 50%),
      url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ec4899' fill-opacity='0.02'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
  }
  
  .application-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    position: relative;
    z-index: 1;
  }
  
  @media (min-width: 1024px) {
    .application-grid {
      grid-template-columns: 1.5fr 1fr;
      gap: 4rem;
    }
  }
  
  /* Form Card */
  .form-card {
    padding: 3rem 2.5rem;
    border: 1.5px solid rgba(236, 72, 153, 0.12);
    box-shadow: 
      var(--shadow-md),
      0 0 30px rgba(236, 72, 153, 0.08);
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    overflow: hidden;
  }
  
  .form-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, 
      rgba(236, 72, 153, 0.04),
      rgba(139, 92, 246, 0.04)
    );
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  
  .form-card:hover::before {
    opacity: 1;
  }
  
  [data-theme="dark"] .form-card {
    background: rgba(18, 18, 26, 0.8);
    backdrop-filter: blur(8px);
    border-color: rgba(236, 72, 153, 0.18);
    box-shadow: 
      var(--shadow-md),
      0 0 35px rgba(236, 72, 153, 0.12);
  }
  
  .form-title {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    margin-bottom: 1rem;
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  
  .form-description {
    color: var(--text-secondary);
    opacity: 0.9;
    line-height: 1.7;
    margin-bottom: 3rem;
    font-size: 0.9375rem;
  }
  
  .application-form {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }
  
  .form-section {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
  
  .section-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-primary);
    padding-bottom: 1rem;
    margin-bottom: 0.5rem;
    border-bottom: 2px solid rgba(236, 72, 153, 0.15);
    position: relative;
    letter-spacing: -0.01em;
  }
  
  .section-title::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 50px;
    height: 2px;
    background: linear-gradient(90deg, 
      var(--color-primary-500),
      transparent
    );
  }
  
  .form-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }
  
  @media (min-width: 640px) {
    .form-row {
      grid-template-columns: 1fr 1fr;
    }
  }
  
  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  
  .form-group label {
    font-weight: 600;
    color: var(--text-primary);
    font-size: 0.9375rem;
    opacity: 0.95;
  }
  
  .form-group input,
  .form-group select,
  .form-group textarea {
    padding: 1rem 1.25rem;
    border: 1.5px solid rgba(236, 72, 153, 0.18);
    border-radius: var(--radius-lg);
    background: var(--bg-primary);
    color: var(--text-primary);
    font-size: 1rem;
    font-family: var(--font-primary);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
  }
  
  .form-group input::placeholder,
  .form-group textarea::placeholder {
    color: var(--text-tertiary);
    opacity: 0.6;
  }
  
  .form-group input:hover,
  .form-group select:hover,
