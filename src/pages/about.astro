---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';

const team = [
  {
    name: 'Dr. Sarah Mitchell',
    role: 'Medical Director',
    specialty: 'Aesthetic Medicine',
    avatar: 'https://images.unsplash.com/photo-1559839734-2b71ea197ec2?w=400&h=400&fit=crop&crop=faces',
    bio: '15+ years of experience in aesthetic medicine and dermatology.'
  },
  {
    name: 'Dr. James Chen',
    role: 'Senior Dermatologist',
    specialty: 'Laser Therapy',
    avatar: 'https://images.unsplash.com/photo-1612349317150-e413f6a5b16d?w=400&h=400&fit=crop&crop=faces',
    bio: 'Specialist in advanced laser treatments and skin rejuvenation.'
  },
  {
    name: 'Emma Rodriguez',
    role: 'Lead Aesthetician',
    specialty: 'Facial Treatments',
    avatar: 'https://images.unsplash.com/photo-1594824476967-48c8b964273f?w=400&h=400&fit=crop&crop=faces',
    bio: 'Certified aesthetician with expertise in facial care and skincare.'
  },
  {
    name: 'Dr. Michael Park',
    role: 'Cosmetic Surgeon',
    specialty: 'Anti-Aging',
    avatar: 'https://images.unsplash.com/photo-1622253692010-333f2da6031d?w=400&h=400&fit=crop&crop=faces',
    bio: 'Board-certified surgeon specializing in non-invasive procedures.'
  }
];

const values = [
  {
    icon: 'excellence',
    title: 'Excellence',
    description: 'We strive for excellence in every treatment and interaction.'
  },
  {
    icon: 'care',
    title: 'Care',
    description: 'Your comfort and satisfaction are our top priorities.'
  },
  {
    icon: 'innovation',
    title: 'Innovation',
    description: 'We use the latest technology and techniques in beauty care.'
  },
  {
    icon: 'trust',
    title: 'Trust',
    description: 'Building lasting relationships based on trust and results.'
  }
];
---

<BaseLayout 
  title="About Us - Beauty Clinic"
  description="Learn about our mission, values, and expert team dedicated to helping you achieve your beauty goals with premium care and advanced treatments."
>
  <Header />
  
  <main>
    <!-- Hero Section -->
    <section class="page-hero">
      <div class="container">
        <h1 class="hero-title">About Our Clinic</h1>
        <p class="hero-subtitle">
          Dedicated to excellence in beauty and wellness since 2026
        </p>
      </div>
    </section>
    
    <!-- Story Section -->
    <section class="story-section section">
      <div class="container">
        <div class="story-grid">
          <div class="story-visual">
            <div class="visual-card">
              <div class="visual-image-wrapper">
                <img 
                  src="https://images.unsplash.com/photo-1519494026892-80bbd2d6fd0d?w=1200&h=900&fit=crop&q=85" 
                  alt="Modern beauty clinic interior" 
                  class="visual-image"
                  loading="lazy"
                />
                <div class="visual-overlay"></div>
                <div class="visual-badge">
                  <span class="badge-year">Since 2026</span>
                  <span class="badge-text">Excellence in Beauty Care</span>
                </div>
              </div>
            </div>
          </div>
          
          <div class="story-content">
            <h2 class="section-title">Our Story</h2>
            <p class="story-text">
              Founded in 2026, Beauty Clinic has been at the forefront of aesthetic medicine and beauty care. What started as a small practice has grown into a premier destination for those seeking transformative beauty treatments.
            </p>
            <p class="story-text">
              Our journey has been driven by a passion for helping people feel confident and beautiful in their own skin. We combine cutting-edge technology with personalized care to deliver exceptional results.
            </p>
            <p class="story-text">
              Today, we are proud to serve thousands of satisfied clients with a team of highly skilled professionals and state-of-the-art facilities.
            </p>
          </div>
        </div>
      </div>
    </section>
    
    <!-- Values Section -->
    <section class="values-section section">
      <div class="container">
        <h2 class="section-title">Our Values</h2>
        <p class="section-subtitle">
          The principles that guide everything we do
        </p>
        
        <div class="values-grid">
          {values.map((value) => (
            <div class="value-card card">
              <div class="value-icon">
                {value.icon === 'excellence' && (
                  <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path>
                  </svg>
                )}
                {value.icon === 'care' && (
                  <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                  </svg>
                )}
                {value.icon === 'innovation' && (
                  <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"></circle>
                    <path d="M12 6v6l4 2"></path>
                    <path d="M16.24 7.76l-1.41 1.41"></path>
                    <path d="M7.76 16.24l1.41-1.41"></path>
                  </svg>
                )}
                {value.icon === 'trust' && (
                  <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                    <path d="M9 12l2 2 4-4"></path>
                  </svg>
                )}
              </div>
              <h3 class="value-title">{value.title}</h3>
              <p class="value-description">{value.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
    
    <!-- Team Section -->
    <section class="team-section section">
      <div class="container">
        <h2 class="section-title">Meet Our Expert Team</h2>
        <p class="section-subtitle">
          Certified professionals dedicated to your beauty journey
        </p>
        
        <div class="team-grid">
          {team.map((member) => (
            <div class="team-card card">
              <div class="member-avatar">
                <img src={member.avatar} alt={member.name} loading="lazy" />
              </div>
              <h3 class="member-name">{member.name}</h3>
              <div class="member-role">{member.role}</div>
              <div class="member-specialty">{member.specialty}</div>
              <p class="member-bio">{member.bio}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
    
    <!-- Stats Section -->
    <section class="stats-section section">
      <div class="container">
        <div class="stats-container">
          <div class="stat-item">
            <div class="stat-number">15+</div>
            <div class="stat-label">Years of Excellence</div>
          </div>
          <div class="stat-item">
            <div class="stat-number">10K+</div>
            <div class="stat-label">Happy Clients</div>
          </div>
          <div class="stat-item">
            <div class="stat-number">50+</div>
            <div class="stat-label">Expert Professionals</div>
          </div>
          <div class="stat-item">
            <div class="stat-number">100+</div>
            <div class="stat-label">Treatments Offered</div>
          </div>
        </div>
      </div>
    </section>
    
    <!-- CTA Section -->
    <section class="cta-section">
      <div class="container">
        <div class="cta-content">
          <h2 class="cta-title">Ready to Start Your Beauty Journey?</h2>
          <p class="cta-text">
            Join thousands of satisfied clients and experience the difference of premium beauty care.
          </p>
          <div class="cta-buttons">
            <a href="/booking" class="btn btn-primary btn-large">Book Appointment</a>
            <a href="/contact" class="btn btn-secondary btn-large">Contact Us</a>
          </div>
        </div>
      </div>
    </section>
  </main>
  
  <Footer />
</BaseLayout>

<style>
  /* Hero Section - Premium Enhancement */
  .page-hero {
    padding: calc(80px + 6rem) 0 6rem;
    background: linear-gradient(135deg, 
      rgba(168, 85, 247, 0.15) 0%,
      rgba(219, 39, 119, 0.15) 50%,
      rgba(249, 115, 22, 0.12) 100%
    );
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  
  .page-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: 
      radial-gradient(circle at 50% 50%, rgba(236, 72, 153, 0.08) 0%, transparent 70%),
      radial-gradient(ellipse at top, rgba(0, 0, 0, 0.02) 0%, transparent 50%),
      radial-gradient(ellipse at bottom, rgba(0, 0, 0, 0.03) 0%, transparent 50%);
    pointer-events: none;
  }
  
  [data-theme="dark"] .page-hero {
    background: linear-gradient(135deg, 
      rgba(88, 28, 135, 0.4) 0%,
      rgba(136, 19, 55, 0.4) 50%,
      rgba(154, 52, 18, 0.3) 100%
    );
  }
  
  [data-theme="dark"] .page-hero::before {
    background: 
      radial-gradient(circle at 50% 50%, rgba(236, 72, 153, 0.12) 0%, transparent 70%),
      radial-gradient(ellipse at top, rgba(0, 0, 0, 0.3) 0%, transparent 50%),
      radial-gradient(ellipse at bottom, rgba(0, 0, 0, 0.4) 0%, transparent 50%);
  }
  
  .hero-title {
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 800;
    margin-bottom: 1.5rem;
    position: relative;
    z-index: 1;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    letter-spacing: -0.02em;
    line-height: 1.1;
  }
  
  [data-theme="dark"] .hero-title {
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.3);
  }
  
  .hero-subtitle {
    font-size: clamp(1.125rem, 2vw, 1.5rem);
    color: var(--text-secondary);
    opacity: var(--text-opacity-secondary);
    max-width: 700px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
    line-height: 1.6;
    font-weight: 400;
  }
  
  /* Section Base - Consistent Spacing */
  .section {
    padding: 6.25rem 0; /* 100px consistent with homepage */
  }
  
  .section-title {
    font-size: clamp(2rem, 4vw, 3rem);
    text-align: center;
    margin-bottom: 1rem;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }
  
  [data-theme="dark"] .section-title {
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.3);
  }
  
  .section-subtitle {
    font-size: 1.125rem;
    text-align: center;
    color: var(--text-secondary);
    opacity: var(--text-opacity-secondary);
    margin-bottom: 4rem; /* 64px consistent spacing */
    max-width: 700px;
    margin-left: auto;
    margin-right: auto;
    line-height: 1.7;
    font-weight: 400;
  }
  
  /* Story Section */
  .story-section {
    background: var(--bg-primary);
  }
  
  .story-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 4rem;
    align-items: center;
  }
  
  @media (min-width: 1024px) {
    .story-grid {
      grid-template-columns: 1fr 1fr;
      gap: 5rem;
    }
  }
  
  .visual-card {
    border-radius: var(--radius-2xl);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
    border: 1px solid rgba(236, 72, 153, 0.2);
    transition: all var(--transition-base);
    aspect-ratio: 5 / 6;
    position: relative;
  }
  
  .visual-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-xl);
    border-color: rgba(236, 72, 153, 0.3);
  }
  
  [data-theme="dark"] .visual-card {
    box-shadow: var(--shadow-lg), 0 0 40px rgba(236, 72, 153, 0.2);
  }
  
  [data-theme="dark"] .visual-card:hover {
    box-shadow: var(--shadow-xl), 0 0 50px rgba(236, 72, 153, 0.3);
  }
  
  /* Visual Image Wrapper for Story Section */
  .visual-image-wrapper {
    width: 100%;
    height: 100%;
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-2xl);
  }
  
  .visual-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform 0.4s ease;
  }
  
  .visual-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      135deg,
      rgba(236, 72, 153, 0.08) 0%,
      rgba(139, 92, 246, 0.08) 50%,
      rgba(249, 115, 22, 0.05) 100%
    );
    opacity: 0.3;
    transition: opacity 0.3s ease;
    z-index: 1;
  }
  
  .visual-card:hover .visual-image {
    transform: scale(1.05);
  }
  
  .visual-card:hover .visual-overlay {
    opacity: 0.2;
  }
  
  [data-theme="dark"] .visual-overlay {
    background: linear-gradient(
      135deg,
      rgba(236, 72, 153, 0.12) 0%,
      rgba(139, 92, 246, 0.12) 50%,
      rgba(249, 115, 22, 0.08) 100%
    );
    opacity: 0.4;
  }
  
  [data-theme="dark"] .visual-card:hover .visual-overlay {
    opacity: 0.3;
  }
  
  /* Visual Badge Overlay */
  .visual-badge {
    position: absolute;
    bottom: 2rem;
    left: 2rem;
    right: 2rem;
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(12px);
    padding: 1.5rem 2rem;
    border-radius: 1rem;
    z-index: 2;
    box-shadow: 
      0 8px 24px rgba(0, 0, 0, 0.4),
      0 0 0 1px rgba(255, 255, 255, 0.1);
    transition: all var(--transition-base);
  }
  
  .visual-card:hover .visual-badge {
    transform: translateY(-4px);
    box-shadow: 
      0 12px 32px rgba(0, 0, 0, 0.5),
      0 0 0 1px rgba(255, 255, 255, 0.15);
  }
  
  .badge-year {
    display: block;
    font-size: 2rem;
    font-weight: 700;
    color: white;
    margin-bottom: 0.5rem;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
    letter-spacing: -0.01em;
  }
  
  .badge-text {
    display: block;
    font-size: 1.125rem;
    font-weight: 500;
    color: rgba(236, 72, 153, 0.95);
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.3);
    filter: drop-shadow(0 0 8px rgba(236, 72, 153, 0.3));
  }
  
  .story-text {
    font-size: 1.125rem;
    line-height: 1.8;
    color: var(--text-secondary);
    opacity: var(--text-opacity-secondary);
    margin-bottom: 2rem; /* 32px consistent spacing */
    max-width: 65ch;
    font-weight: 400;
  }
  
  .story-text:last-child {
    margin-bottom: 0;
  }
  
  /* Values Section */
  .values-section {
    background: var(--bg-secondary);
  }
  
  .values-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem; /* 32px consistent spacing */
    align-items: stretch;
  }
  
  .value-card {
    text-align: center;
    padding: 2.5rem 2rem;
    min-height: 300px;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: center;
    transition: all var(--transition-base);
    border-radius: var(--radius-xl);
    background: var(--bg-secondary);
    box-shadow: var(--shadow-sm);
    border: 1px solid rgba(236, 72, 153, 0.08);
    position: relative;
    overflow: hidden;
  }
  
  .value-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, 
      rgba(236, 72, 153, 0.02) 0%,
      rgba(139, 92, 246, 0.02) 100%
    );
    opacity: 0;
    transition: opacity var(--transition-base);
  }
  
  .value-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
    border-color: rgba(236, 72, 153, 0.15);
  }
  
  .value-card:hover::before {
    opacity: 1;
  }
  
  [data-theme="dark"] .value-card {
    background: var(--bg-secondary);
    border-color: rgba(236, 72, 153, 0.12);
  }
  
  [data-theme="dark"] .value-card:hover {
    box-shadow: var(--shadow-md), 0 0 30px rgba(236, 72, 153, 0.15);
    border-color: rgba(236, 72, 153, 0.25);
  }
  
  .value-icon {
    width: 64px;
    height: 64px;
    margin: 0 auto 1.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, 
      rgba(236, 72, 153, 0.12), 
      rgba(139, 92, 246, 0.12)
    );
    border-radius: 16px;
    transition: all var(--transition-base);
    box-shadow: 0 2px 8px rgba(236, 72, 153, 0.1);
  }
  
  .value-icon svg {
    stroke: var(--color-primary-600);
    stroke-width: 2;
    transition: all var(--transition-base);
  }
  
  [data-theme="dark"] .value-icon {
    background: linear-gradient(135deg, 
      rgba(236, 72, 153, 0.25), 
      rgba(139, 92, 246, 0.25)
    );
    box-shadow: 
      0 4px 12px rgba(236, 72, 153, 0.3),
      0 0 20px rgba(236, 72, 153, 0.15),
      inset 0 1px 0 rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(236, 72, 153, 0.3);
  }
  
  [data-theme="dark"] .value-icon svg {
    stroke: #f472b6;
    filter: drop-shadow(0 0 8px rgba(244, 114, 182, 0.6));
  }
  
  .value-card:hover .value-icon {
    transform: scale(1.1) rotate(-3deg);
    box-shadow: 0 4px 16px rgba(236, 72, 153, 0.2);
    background: linear-gradient(135deg, 
      rgba(236, 72, 153, 0.18), 
      rgba(139, 92, 246, 0.18)
    );
  }
  
  [data-theme="dark"] .value-card:hover .value-icon {
    box-shadow: 
      0 6px 20px rgba(236, 72, 153, 0.5),
      0 0 30px rgba(236, 72, 153, 0.3),
      inset 0 1px 0 rgba(255, 255, 255, 0.15);
    background: linear-gradient(135deg, 
      rgba(236, 72, 153, 0.35), 
      rgba(139, 92, 246, 0.35)
    );
    border-color: rgba(236, 72, 153, 0.5);
  }
  
  [data-theme="dark"] .value-card:hover .value-icon svg {
    stroke: #fda4af;
    filter: drop-shadow(0 0 12px rgba(253, 164, 175, 0.8));
  }
  
  .value-title {
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 1rem;
    letter-spacing: -0.01em;
  }
  
  .value-description {
    color: var(--text-secondary);
    opacity: var(--text-opacity-secondary);
    line-height: 1.7;
    font-size: 1rem;
    max-width: 30ch;
  }
  
  /* Team Section */
  .team-section {
    background: var(--bg-primary);
  }
  
  .team-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem; /* 32px consistent spacing */
    align-items: stretch;
  }
  
  .team-card {
    text-align: center;
    padding: 2.5rem 2rem;
    min-height: 400px;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: center;
    background: linear-gradient(135deg, 
      rgba(30, 27, 75, 0.4) 0%,
      rgba(74, 58, 119, 0.5) 50%,
      rgba(88, 28, 135, 0.4) 100%
    );
    border-radius: var(--radius-xl);
    position: relative;
    overflow: hidden;
    transition: all var(--transition-base);
    box-shadow: var(--shadow-sm);
    border: 1px solid rgba(236, 72, 153, 0.15);
  }
  
  .team-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, 
      rgba(236, 72, 153, 0.04) 0%,
      rgba(139, 92, 246, 0.04) 50%,
      rgba(249, 115, 22, 0.04) 100%
    );
    backdrop-filter: blur(8px);
    pointer-events: none;
    z-index: 0;
  }
  
  .team-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
    border-color: rgba(236, 72, 153, 0.25);
  }
  
  [data-theme="dark"] .team-card {
    background: linear-gradient(135deg, 
      rgba(20, 18, 50, 0.5) 0%,
      rgba(50, 35, 80, 0.6) 50%,
      rgba(70, 20, 100, 0.5) 100%
    );
    border-color: rgba(236, 72, 153, 0.2);
  }
  
  [data-theme="dark"] .team-card:hover {
    box-shadow: var(--shadow-md), 0 0 35px rgba(236, 72, 153, 0.2);
    border-color: rgba(236, 72, 153, 0.35);
  }
  
  .member-avatar {
    width: 120px;
    height: 120px;
    margin: 0 auto 1.5rem;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2px solid rgba(236, 72, 153, 0.3);
    box-shadow: 
      0 4px 16px rgba(236, 72, 153, 0.2),
      0 0 30px rgba(236, 72, 153, 0.12);
    transition: all var(--transition-base);
    position: relative;
    z-index: 1;
    overflow: hidden;
  }
  
  .member-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }
  
  .team-card:hover .member-avatar {
    transform: scale(1.08);
    border-color: rgba(236, 72, 153, 0.5);
    box-shadow: 
      0 6px 20px rgba(236, 72, 153, 0.3),
      0 0 40px rgba(236, 72, 153, 0.2);
  }
  
  .member-name {
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
    position: relative;
    z-index: 1;
    color: rgba(255, 255, 255, 0.98);
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.2);
    letter-spacing: -0.01em;
  }
  
  .member-role {
    font-weight: 700;
    color: rgba(236, 72, 153, 0.95);
    margin-bottom: 0.5rem;
    font-size: 1rem;
    filter: drop-shadow(0 0 8px rgba(236, 72, 153, 0.2));
    position: relative;
    z-index: 1;
  }
  
  .member-specialty {
    font-size: 0.9375rem;
    color: rgba(255, 255, 255, 0.85);
    margin-bottom: 1rem;
    font-weight: 500;
    position: relative;
    z-index: 1;
  }
  
  .member-bio {
