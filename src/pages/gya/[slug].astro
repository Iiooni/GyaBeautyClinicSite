---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import '@/styles/booking.css';
import '@/styles/homepage.css';
import Certifications from '@/components/Certifications.astro';
import MeetGya from '@/components/MeetGya.astro';
import ConsultationSteps from '@/components/ConsultationSteps.astro';
import BeforeAndAfter from '@/components/BeforeAndAfter.astro';
import Testimonials from '@/components/Testimonials.astro';
import Faqs from '@/components/Faqs.astro';

// Landing page data 
const landingPageData = {
  'transformation': {
    title: 'Clear your doubts',
    titleSecondRow: 'So you can put your best foot forward',
    excerpt: 'Whether that’s at work, in relationships, or when you look in the mirror.',
    treatment: 'Facial Balancing Treatment',
    location: 'Nottinghashire',
    category: 'Transformation',
    author: 'Gya',
    authorRole: 'Medical Director',
    date: '2026-06-19',
    readingTime: '8 min read',
    tags: ['skincare', 'rejuvenation', 'lines', 'wrinkles'],
    cover: '/images/landingPages/transformation.png'
  }
};

// Generate static paths for all blog posts
export function getStaticPaths(){
  // Define landing pages data inside getStaticPathsLanding to ensure it's available during build
  const landingPages = {
    'transformation' : {
      title: 'Clear your doubts',
      titleSecondRow: 'So you can put your best foot forward',
      excerpt: 'Whether that’s at work, in relationships, or when you look in the mirror.',
      treatment: 'Facial Balancing Treatment',
      location: 'Nottinghashire',
      category: 'Transformation',
      author: 'Gya',
      authorRole: 'Medical Director',
      date: '2026-06-19',
      readingTime: '8 min read',
      tags: ['skincare', 'rejuvenation', 'lines', 'wrinkles'],
      cover: '/images/landingPages/transformation.png'
    }
  };

    return Object.keys(landingPages).map(slug => ({
    params: { slug }
  }));
}


const { slug } = Astro.params;
const page = landingPageData[slug as keyof typeof landingPageData];

// Get related posts (exclude current article)
const allSlugs = Object.keys(landingPageData).filter(s => s !== slug);
const relatedSlugs = allSlugs.slice(0, 3);
const relatedPage = relatedSlugs.map(relatedSlug => {
  const lPage = landingPageData[relatedSlug as keyof typeof landingPageData];
  return {
    slug: relatedSlug,
    title: lPage.title,
    category: lPage.category,
    date: lPage.date,
    cover: lPage.cover
  };
});
