---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';

const lastUpdated = 'March 1, 2026';

const sections = [
  {
    id: 'introduction',
    title: 'Introduction',
    content: `Welcome to Beauty Clinic. We are committed to protecting your personal information and your right to privacy. This Privacy Policy explains how we collect, use, disclose, and safeguard your information when you visit our website or use our services. Please read this privacy policy carefully. If you do not agree with the terms of this privacy policy, please do not access the site or use our services.`
  },
  {
    id: 'information-collection',
    title: 'Information We Collect',
    content: `We collect personal information that you voluntarily provide to us when you register for services, express an interest in obtaining information about us or our products and services, or otherwise contact us.`,
    subsections: [
      {
        title: 'Personal Information',
        items: [
          'Name and contact information (email, phone number, address)',
          'Date of birth and age',
          'Medical history and health information',
          'Treatment preferences and records',
          'Payment and billing information',
          'Photos and images for treatment documentation'
        ]
      },
      {
        title: 'Automatically Collected Information',
        items: [
          'IP address and browser type',
          'Device information',
          'Usage data and analytics',
          'Cookies and tracking technologies'
        ]
      }
    ]
  },
  {
    id: 'information-use',
    title: 'How We Use Your Information',
    content: `We use the information we collect or receive to:`,
    subsections: [
      {
        title: 'Primary Uses',
        items: [
          'Provide, operate, and maintain our services',
          'Process your appointments and treatments',
          'Send you treatment reminders and follow-up care instructions',
          'Process payments and maintain billing records',
          'Respond to your inquiries and provide customer support',
          'Send you marketing communications (with your consent)',
          'Improve our website and services',
          'Comply with legal obligations and protect our rights'
        ]
      }
    ]
  },
  {
    id: 'information-sharing',
    title: 'Information Sharing and Disclosure',
    content: `We may share your information in the following situations:`,
    subsections: [
      {
        title: 'We Share Information With',
        items: [
          'Healthcare providers involved in your treatment',
          'Service providers who assist our operations (payment processors, IT services)',
          'Insurance companies for billing and claims processing',
          'Legal authorities when required by law',
          'Business partners with your explicit consent'
        ]
      }
    ]
  },
  {
    id: 'data-security',
    title: 'Data Security',
    content: `We implement appropriate technical and organizational security measures to protect your personal information. However, no electronic transmission over the internet or information storage technology can be guaranteed to be 100% secure. We use:`,
    subsections: [
      {
        title: 'Security Measures',
        items: [
          'Encryption of sensitive data in transit and at rest',
          'Secure servers and firewalls',
          'Regular security audits and updates',
          'Access controls and authentication',
          'Employee training on data protection',
          'HIPAA-compliant practices for medical information'
        ]
      }
    ]
  },
  {
    id: 'your-rights',
    title: 'Your Privacy Rights',
    content: `You have certain rights regarding your personal information:`,
    subsections: [
      {
        title: 'Your Rights Include',
        items: [
          'Access: Request copies of your personal information',
          'Correction: Request correction of inaccurate information',
          'Deletion: Request deletion of your personal information',
          'Restriction: Request restriction of processing your information',
          'Portability: Request transfer of your information',
          'Objection: Object to processing of your information',
          'Withdraw Consent: Withdraw consent for marketing communications'
        ]
      }
    ]
  },
  {
    id: 'cookies',
    title: 'Cookies and Tracking',
    content: `We use cookies and similar tracking technologies to track activity on our website and store certain information. You can instruct your browser to refuse all cookies or to indicate when a cookie is being sent.`,
    subsections: [
      {
        title: 'Types of Cookies We Use',
        items: [
          'Essential cookies for website functionality',
          'Analytics cookies to understand usage patterns',
          'Preference cookies to remember your settings',
          'Marketing cookies for targeted advertising (with consent)'
        ]
      }
    ]
  },
  {
    id: 'data-retention',
    title: 'Data Retention',
    content: `We retain your personal information only for as long as necessary to fulfill the purposes outlined in this privacy policy, unless a longer retention period is required by law. Medical records are retained according to applicable healthcare regulations.`
  },
  {
    id: 'children',
    title: "Children's Privacy",
    content: `Our services are not directed to individuals under the age of 18. We do not knowingly collect personal information from children. If you are a parent or guardian and believe your child has provided us with personal information, please contact us.`
  },
  {
    id: 'changes',
    title: 'Changes to This Privacy Policy',
    content: `We may update this privacy policy from time to time. We will notify you of any changes by posting the new privacy policy on this page and updating the "Last Updated" date. You are advised to review this privacy policy periodically for any changes.`
  },
  {
    id: 'contact',
    title: 'Contact Us',
    content: `If you have questions or concerns about this privacy policy or our data practices, please contact us:`,
    contact: {
      email: 'privacy@beautyclinic.com',
      phone: '+1 (234) 567-8900',
      address: '123 Beauty Street, City, State 12345, United States'
    }
  }
];
---

<BaseLayout 
  title="Privacy Policy - Beauty Clinic"
  description="Learn how Beauty Clinic collects, uses, and protects your personal information. Read our comprehensive privacy policy."
>
  <Header />
  
  <main>
    <!-- Hero Section -->
    <section class="privacy-hero">
      <div class="container">
        <div class="hero-content">
          <div class="hero-badge">Legal</div>
          <h1 class="hero-title">Privacy Policy</h1>
          <p class="hero-description">
            Your privacy is important to us. Learn how we protect your personal information.
          </p>
          <div class="last-updated">
            Last Updated: <strong>{lastUpdated}</strong>
          </div>
        </div>
      </div>
    </section>

    <!-- Table of Contents -->
    <section class="toc-section">
      <div class="container">
        <div class="toc-card card">
          <h2 class="toc-title">Table of Contents</h2>
          <nav class="toc-nav">
            {sections.map((section, index) => (
              <a href={`#${section.id}`} class="toc-link">
                <span class="toc-number">{index + 1}.</span>
                <span>{section.title}</span>
              </a>
            ))}
          </nav>
        </div>
      </div>
    </section>

    <!-- Privacy Content Section -->
    <section class="privacy-content-section">
      <div class="container">
        <div class="content-wrapper">
          {sections.map((section) => (
            <article id={section.id} class="content-section card">
              <h2 class="section-title">{section.title}</h2>
              <p class="section-content">{section.content}</p>
              
              {section.subsections && section.subsections.map((subsection) => (
                <div class="subsection">
                  <h3 class="subsection-title">{subsection.title}</h3>
                  <ul class="content-list">
                    {subsection.items.map((item) => (
                      <li class="list-item">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                          <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
              
              {section.contact && (
                <div class="contact-info">
                  <div class="contact-item">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                      <polyline points="22,6 12,13 2,6"></polyline>
                    </svg>
                    <a href={`mailto:${section.contact.email}`}>{section.contact.email}</a>
                  </div>
                  <div class="contact-item">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                    </svg>
                    <a href={`tel:${section.contact.phone}`}>{section.contact.phone}</a>
                  </div>
                  <div class="contact-item">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                      <circle cx="12" cy="10" r="3"></circle>
                    </svg>
                    <span>{section.contact.address}</span>
                  </div>
                </div>
              )}
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="privacy-cta-section">
      <div class="container">
        <div class="cta-content">
          <h2 class="cta-title">Questions About Your Privacy?</h2>
          <p class="cta-description">
            Our team is here to address any concerns about how we handle your personal information.
          </p>
          <a href="/contact" class="btn btn-primary btn-large">
            Contact Us
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>
      </div>
    </section>
  </main>
  
  <Footer />
</BaseLayout>


<style>
  /* ===== HERO SECTION - ENHANCED READABILITY ===== */
  .privacy-hero {
    padding: calc(80px + 6rem) 0 5rem;
    background: 
      linear-gradient(to bottom, 
        transparent 0%,
        transparent 70%,
        rgba(0, 0, 0, 0.03) 100%
      ),
      linear-gradient(135deg, 
        rgba(168, 85, 247, 0.15) 0%,
        rgba(219, 39, 119, 0.15) 50%,
        rgba(249, 115, 22, 0.12) 100%
      );
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  
  .privacy-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: 
      radial-gradient(ellipse at 50% 20%, rgba(236, 72, 153, 0.12) 0%, transparent 40%),
      radial-gradient(ellipse at 50% 100%, rgba(236, 72, 153, 0.08) 0%, transparent 50%),
      radial-gradient(circle at 50% 50%, rgba(236, 72, 153, 0.15) 0%, transparent 70%),
      url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ec4899' fill-opacity='0.015'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
    pointer-events: none;
    animation: pulse 4s ease-in-out infinite;
  }
  
  @keyframes pulse {
    0%, 100% { opacity: 0.5; }
    50% { opacity: 1; }
  }
  
  /* Enhanced separator with fade */
  .privacy-hero::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 80px;
    background: linear-gradient(to bottom,
      transparent 0%,
      rgba(0, 0, 0, 0.02) 50%,
      rgba(0, 0, 0, 0.03) 100%
    );
    pointer-events: none;
  }
  
  [data-theme="dark"] .privacy-hero {
    background: 
      linear-gradient(to bottom, 
        transparent 0%,
        transparent 70%,
        rgba(0, 0, 0, 0.2) 100%
      ),
      linear-gradient(135deg, 
        rgba(88, 28, 135, 0.4) 0%,
        rgba(136, 19, 55, 0.4) 50%,
        rgba(154, 52, 18, 0.3) 100%
      );
  }

  [data-theme="dark"] .privacy-hero::before {
    background: 
      radial-gradient(ellipse at 50% 20%, rgba(236, 72, 153, 0.18) 0%, transparent 40%),
      radial-gradient(ellipse at 50% 100%, rgba(236, 72, 153, 0.12) 0%, transparent 50%),
      radial-gradient(circle at 50% 50%, rgba(236, 72, 153, 0.2) 0%, transparent 70%),
      url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ec4899' fill-opacity='0.02'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
  }
  
  [data-theme="dark"] .privacy-hero::after {
    background: linear-gradient(to bottom,
      transparent 0%,
      rgba(0, 0, 0, 0.1) 50%,
      rgba(0, 0, 0, 0.15) 100%
    );
  }
  
  .hero-content {
    max-width: 900px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }
  
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.625rem 1.25rem;
    background: linear-gradient(135deg, rgba(236, 72, 153, 0.15), rgba(219, 39, 119, 0.15));
    border: 1.5px solid rgba(236, 72, 153, 0.3);
    border-radius: 999px;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-primary-600);
    margin-bottom: 2rem;
    box-shadow: 0 4px 12px rgba(236, 72, 153, 0.2);
  }
  
  [data-theme="dark"] .hero-badge {
    background: linear-gradient(135deg, rgba(236, 72, 153, 0.25), rgba(219, 39, 119, 0.25));
    border-color: rgba(236, 72, 153, 0.4);
    color: rgba(236, 72, 153, 0.95);
  }
  
  .hero-title {
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    margin-bottom: 2rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.1;
    color: var(--text-primary);
  }
  
  .hero-description {
    font-size: clamp(1.125rem, 2vw, 1.375rem);
    color: var(--text-primary);
    opacity: 0.85;
    max-width: 700px;
    margin: 0 auto 2rem;
    line-height: 1.7;
  }
  
  [data-theme="dark"] .hero-description {
    opacity: 0.9;
  }
  
  .last-updated {
    font-size: 1rem;
    color: var(--text-secondary);
    opacity: 0.85;
  }
  
  .last-updated strong {
    color: var(--color-primary-600);
    font-weight: 600;
  }

  /* ===== TABLE OF CONTENTS - ENHANCED STRUCTURE ===== */
  .toc-section {
    background: var(--bg-primary);
    padding: 4rem 0;
    position: relative;
  }
  
  .toc-card {
    max-width: 800px;
    margin: 0 auto;
    padding: 2.5rem 2rem;
    background: var(--bg-secondary);
    border-radius: var(--radius-xl);
    border: 1.5px solid rgba(236, 72, 153, 0.18);
    box-shadow: 
      var(--shadow-md),
      0 0 30px rgba(236, 72, 153, 0.08);
    transition: all 0.3s ease;
  }
  
  .toc-card:hover {
    box-shadow: 
      var(--shadow-lg),
      0 0 40px rgba(236, 72, 153, 0.12);
    border-color: rgba(236, 72, 153, 0.25);
  }
  
  [data-theme="dark"] .toc-card {
    background: rgba(18, 18, 26, 0.8);
    backdrop-filter: blur(8px);
    border-color: rgba(236, 72, 153, 0.25);
    box-shadow: 
      var(--shadow-md),
      0 0 30px rgba(236, 72, 153, 0.12);
  }
  
  .toc-title {
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 2rem;
    color: var(--text-primary);
    padding-bottom: 1rem;
    border-bottom: 2px solid rgba(236, 72, 153, 0.15);
    position: relative;
  }
  
  .toc-title::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 60px;
    height: 2px;
    background: linear-gradient(90deg, 
      var(--color-primary-500),
      transparent
    );
  }
  
  .toc-nav {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.5rem;
  }
  
  .toc-link {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    padding: 1rem 1.25rem;
    border-radius: var(--radius-lg);
    text-decoration: none;
    color: var(--text-secondary);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    border: 1px solid transparent;
    font-size: 0.9375rem;
    position: relative;
  }
  
  .toc-link::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 0;
    height: 2px;
    background: var(--color-primary-500);
    transition: width 0.3s ease;
  }
  
  .toc-link:hover {
    background: rgba(236, 72, 153, 0.08);
    color: var(--color-primary-600);
    border-color: rgba(236, 72, 153, 0.2);
    transform: translateX(8px);
    padding-left: 1.5rem;
  }
  
  .toc-link:hover::before {
    width: 4px;
  }
  
  [data-theme="dark"] .toc-link {
    color: var(--text-primary);
    opacity: 0.85;
  }
  
  [data-theme="dark"] .toc-link:hover {
    background: rgba(236, 72, 153, 0.12);
    opacity: 1;
    color: rgba(236, 72, 153, 0.95);
  }
  
  .toc-number {
    font-weight: 700;
    color: var(--color-primary-500);
    font-size: 0.875rem;
    min-width: 24px;
  }

  /* ===== CONTENT SECTION - ENHANCED READABILITY ===== */
  .privacy-content-section {
    background: var(--bg-primary);
    padding: 4rem 0 8rem;
    position: relative;
  }
  
  .privacy-content-section::before {
    content: '';
    position: absolute;
    inset: 0;
    background: 
      radial-gradient(ellipse at 30% 50%, rgba(236, 72, 153, 0.03) 0%, transparent 50%),
      radial-gradient(ellipse at 70% 50%, rgba(139, 92, 246, 0.03) 0%, transparent 50%),
      url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ec4899' fill-opacity='0.015'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
    pointer-events: none;
  }
  
  [data-theme="dark"] .privacy-content-section::before {
    background: 
      radial-gradient(ellipse at 30% 50%, rgba(236, 72, 153, 0.05) 0%, transparent 50%),
      radial-gradient(ellipse at 70% 50%, rgba(139, 92, 246, 0.05) 0%, transparent 50%),
      url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ec4899' fill-opacity='0.02'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
  }
  
  .content-wrapper {
    max-width: 800px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 3rem;
    position: relative;
    z-index: 1;
  }
  
  .content-section {
    padding: 3rem 2.5rem;
    background: var(--bg-secondary);
    border-radius: var(--radius-xl);
    border: 1.5px solid rgba(236, 72, 153, 0.18);
    box-shadow: 
      var(--shadow-md),
      0 0 30px rgba(236, 72, 153, 0.08);
    scroll-margin-top: 120px;
    transition: all 0.3s ease;
  }
  
  .content-section:hover {
    box-shadow: 
      var(--shadow-lg),
      0 0 40px rgba(236, 72, 153, 0.12);
    border-color: rgba(236, 72, 153, 0.25);
  }
  
  [data-theme="dark"] .content-section {
    background: rgba(18, 18, 26, 0.8);
    backdrop-filter: blur(8px);
    border-color: rgba(236, 72, 153, 0.25);
    box-shadow: 
      var(--shadow-md),
      0 0 30px rgba(236, 72, 153, 0.12);
  }
  
  .section-title {
    font-size: 1.875rem;
    font-weight: 700;
    margin-bottom: 2rem;
    color: var(--text-primary);
    padding-bottom: 1.25rem;
    border-bottom: 2px solid rgba(236, 72, 153, 0.15);
    position: relative;
    letter-spacing: -0.01em;
  }
  
  .section-title::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 60px;
    height: 2px;
    background: linear-gradient(90deg, 
      var(--color-primary-500),
      transparent
    );
  }
  
  .section-content {
    font-size: 1rem;
    color: var(--text-primary);
    opacity: 0.85;
    line-height: 1.9;
    margin-bottom: 2rem;
  }
  
  [data-theme="dark"] .section-content {
    opacity: 0.9;
  }

  .subsection {
    margin-top: 2.5rem;
  }
  
  .subsection-title {
    font-size: 1.125rem;
    font-weight: 600;
    margin-bottom: 1.25rem;
    color: var(--text-primary);
  }
  
  .content-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1.125rem;
  }
  
  .list-item {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    color: var(--text-primary);
    opacity: 0.85;
    font-size: 0.9375rem;
    line-height: 1.8;
    padding-left: 0.25rem;
  }
  
  [data-theme="dark"] .list-item {
    opacity: 0.9;
  }
  
  .list-item svg {
    flex-shrink: 0;
    color: var(--color-primary-500);
    margin-top: 0.25rem;
    filter: drop-shadow(0 2px 6px rgba(236, 72, 153, 0.35));
  }
  
