---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
---

<BaseLayout 
  title="Login - Beauty Clinic"
  description="Sign in to your Beauty Clinic account to manage appointments, view treatment history, and access exclusive member benefits."
>
  <Header />
  
  <main>
    <!-- Login Section -->
    <section class="auth-section">
      <div class="auth-container">
        <!-- Left Side - Form -->
        <div class="auth-form-wrapper reveal-left">
          <div class="auth-form-content">
            <!-- Logo/Brand -->
            <div class="auth-brand">
              <div class="brand-icon">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                </svg>
              </div>
              <h1 class="auth-title">Welcome Back</h1>
              <p class="auth-subtitle">Sign in to continue your beauty journey</p>
            </div>
            
            <!-- Login Form -->
            <form class="auth-form" id="loginForm">
              <div class="form-group">
                <label for="email" class="form-label">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                    <polyline points="22,6 12,13 2,6"></polyline>
                  </svg>
                  Email Address
                </label>
                <input 
                  type="email" 
                  id="email" 
                  name="email" 
                  required
                  placeholder="your@email.com"
                  class="form-input"
                />
              </div>
              
              <div class="form-group">
                <label for="password" class="form-label">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                  </svg>
                  Password
                </label>
                <div class="password-input-wrapper">
                  <input 
                    type="password" 
                    id="password" 
                    name="password" 
                    required
                    placeholder="Enter your password"
                    class="form-input"
                  />
                  <button type="button" class="password-toggle" id="togglePassword">
                    <svg class="eye-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                      <circle cx="12" cy="12" r="3"></circle>
                    </svg>
                  </button>
                </div>
              </div>
              
              <div class="form-options">
                <label class="checkbox-label">
                  <input type="checkbox" name="remember" />
                  <span class="checkbox-text">Remember me</span>
                </label>
                <a href="/forgot-password" class="forgot-link">Forgot password?</a>
              </div>
              
              <button type="submit" class="btn-auth btn-primary">
                <span>Sign In</span>
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </button>
            </form>
            
            <!-- Divider -->
            <div class="auth-divider">
              <span>or continue with</span>
            </div>
            
            <!-- Social Login -->
            <div class="social-login">
              <button type="button" class="social-btn">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
                  <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                  <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
                  <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
                </svg>
                <span>Google</span>
              </button>
              
              <button type="button" class="social-btn">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z" fill="#1877F2"/>
                </svg>
                <span>Facebook</span>
              </button>
            </div>
            
            <!-- Sign Up Link -->
            <p class="auth-footer">
              Don't have an account? 
              <a href="/register" class="auth-link">Create Account</a>
            </p>
          </div>
        </div>
        
        <!-- Right Side - Visual -->
        <div class="auth-visual reveal-right">
          <div class="visual-content">
            <div class="visual-gradient"></div>
            <div class="visual-pattern"></div>
            
            <div class="visual-text">
              <h2 class="visual-title">Your Beauty Journey Awaits</h2>
              <p class="visual-description">
                Access exclusive treatments, personalized care plans, and member-only benefits. 
                Join thousands of satisfied clients who trust us with their beauty transformation.
              </p>
              
              <div class="visual-features">
                <div class="feature-item">
                  <div class="feature-icon">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                  </div>
                  <span>Easy appointment booking</span>
                </div>
                <div class="feature-item">
                  <div class="feature-icon">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                  </div>
                  <span>Track treatment history</span>
                </div>
                <div class="feature-item">
                  <div class="feature-icon">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                  </div>
                  <span>Exclusive member discounts</span>
                </div>
              </div>
            </div>
            
            <div class="visual-stats">
              <div class="stat-item">
                <div class="stat-number">50K+</div>
                <div class="stat-label">Happy Clients</div>
              </div>
              <div class="stat-item">
                <div class="stat-number">98%</div>
                <div class="stat-label">Satisfaction Rate</div>
              </div>
              <div class="stat-item">
                <div class="stat-number">15+</div>
                <div class="stat-label">Years Experience</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
  
  <Footer />
</BaseLayout>

<style>
  /* Auth Section - Premium Layout */
  .auth-section {
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding: calc(80px + 2rem) 0 2rem;
    background: var(--bg-primary);
    position: relative;
    overflow: hidden;
  }
  
  .auth-section::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 400px;
    background: linear-gradient(135deg, 
      rgba(236, 72, 153, 0.08) 0%,
      rgba(139, 92, 246, 0.08) 50%,
      rgba(249, 115, 22, 0.06) 100%
    );
    pointer-events: none;
  }
  
  [data-theme="dark"] .auth-section::before {
    background: linear-gradient(135deg, 
      rgba(236, 72, 153, 0.12) 0%,
      rgba(139, 92, 246, 0.12) 50%,
      rgba(249, 115, 22, 0.08) 100%
    );
  }
  
  .auth-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 2rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    position: relative;
    z-index: 1;
  }
  
  @media (min-width: 1024px) {
    .auth-container {
      grid-template-columns: 1fr 1fr;
      gap: 5rem;
      align-items: center;
    }
  }
  
  /* Form Wrapper - Premium Card */
  .auth-form-wrapper {
    background: var(--bg-secondary);
    border-radius: 2rem;
    padding: 3rem;
    box-shadow: 
      var(--shadow-lg),
      0 0 60px rgba(236, 72, 153, 0.08);
    border: 1.5px solid rgba(236, 72, 153, 0.12);
    position: relative;
    overflow: hidden;
  }
  
  .auth-form-wrapper::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 200px;
    background: radial-gradient(circle at 50% 0%, 
      rgba(236, 72, 153, 0.08) 0%,
      transparent 70%
    );
    pointer-events: none;
  }
  
  [data-theme="dark"] .auth-form-wrapper {
    background: rgba(18, 18, 26, 0.95);
    backdrop-filter: blur(20px);
    border-color: rgba(236, 72, 153, 0.2);
    box-shadow: 
      var(--shadow-lg),
      0 0 80px rgba(236, 72, 153, 0.12);
  }
  
  .auth-form-content {
    position: relative;
    z-index: 1;
  }
  
  /* Brand Section */
  .auth-brand {
    text-align: center;
    margin-bottom: 3rem;
  }
  
  .brand-icon {
    width: 80px;
    height: 80px;
    margin: 0 auto 1.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, 
      rgba(236, 72, 153, 0.15),
      rgba(139, 92, 246, 0.15)
    );
    border-radius: 50%;
    border: 2px solid rgba(236, 72, 153, 0.3);
    box-shadow: 
      0 8px 32px rgba(236, 72, 153, 0.2),
      0 0 40px rgba(236, 72, 153, 0.15);
    animation: float 3s ease-in-out infinite;
  }
  
  @keyframes float {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-10px); }
  }
  
  .brand-icon svg {
    color: var(--color-primary-500);
    filter: drop-shadow(0 4px 12px rgba(236, 72, 153, 0.4));
  }
  
  [data-theme="dark"] .brand-icon {
    background: linear-gradient(135deg, 
      rgba(236, 72, 153, 0.2),
      rgba(139, 92, 246, 0.2)
    );
    border-color: rgba(236, 72, 153, 0.4);
    box-shadow: 
      0 8px 32px rgba(236, 72, 153, 0.25),
      0 0 50px rgba(236, 72, 153, 0.2);
  }
  
  .auth-title {
    font-size: clamp(2rem, 4vw, 2.5rem);
    font-weight: 800;
    margin-bottom: 0.75rem;
    letter-spacing: -0.02em;
  }
  
  .auth-subtitle {
    font-size: 1.125rem;
    color: var(--text-secondary);
    opacity: 0.9;
  }
  
  /* Form Styles - Premium Inputs */
  .auth-form {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }
  
  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  
  .form-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
    color: var(--text-primary);
    font-size: 0.9375rem;
  }
  
  .form-label svg {
    color: var(--color-primary-500);
    opacity: 0.8;
  }
  
  .form-input {
    width: 100%;
    padding: 1rem 1.25rem;
    border: 2px solid rgba(236, 72, 153, 0.15);
    border-radius: 1rem;
    background: var(--bg-primary);
    color: var(--text-primary);
    font-size: 1rem;
    font-family: var(--font-primary);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
  }
  
  .form-input::placeholder {
    color: var(--text-tertiary);
    opacity: 0.6;
  }
  
  .form-input:hover {
    border-color: rgba(236, 72, 153, 0.3);
    box-shadow: 0 4px 12px rgba(236, 72, 153, 0.08);
  }
  
  .form-input:focus {
    outline: none;
    border-color: rgba(236, 72, 153, 0.6);
    box-shadow: 
      0 0 0 4px rgba(236, 72, 153, 0.12),
      0 4px 16px rgba(236, 72, 153, 0.2);
    transform: translateY(-2px);
  }
  
  [data-theme="dark"] .form-input {
    background: rgba(10, 10, 15, 0.8);
    border-color: rgba(236, 72, 153, 0.25);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
  }
  
  [data-theme="dark"] .form-input:hover {
    border-color: rgba(236, 72, 153, 0.4);
    box-shadow: 0 4px 12px rgba(236, 72, 153, 0.15);
  }
  
  [data-theme="dark"] .form-input:focus {
    border-color: rgba(236, 72, 153, 0.7);
    box-shadow: 
      0 0 0 4px rgba(236, 72, 153, 0.18),
      0 4px 16px rgba(236, 72, 153, 0.25);
  }
  
  /* Password Input with Toggle */
  .password-input-wrapper {
    position: relative;
  }
  
  .password-input-wrapper .form-input {
    padding-right: 3.5rem;
  }
  
  .password-toggle {
    position: absolute;
    right: 1rem;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
    color: var(--text-tertiary);
    transition: all 0.3s ease;
    border-radius: 0.5rem;
  }
  
  .password-toggle:hover {
    color: var(--color-primary-500);
    background: rgba(236, 72, 153, 0.08);
  }
  
  .password-toggle:focus-visible {
    outline: 2px solid var(--color-primary-500);
    outline-offset: 2px;
  }
  
  /* Form Options */
  .form-options {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
  
  .checkbox-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
    user-select: none;
  }
  
  .checkbox-label input[type="checkbox"] {
    width: 18px;
    height: 18px;
    cursor: pointer;
    accent-color: var(--color-primary-500);
  }
  
  .checkbox-text {
    font-size: 0.9375rem;
    color: var(--text-secondary);
  }
  
  .forgot-link {
    font-size: 0.9375rem;
    color: var(--color-primary-600);
    font-weight: 600;
    transition: all 0.3s ease;
  }
  
  .forgot-link:hover {
    color: var(--color-primary-700);
    text-decoration: underline;
  }
  
  /* Auth Button - Premium Style */
  .btn-auth {
    width: 100%;
    padding: 1.125rem 2rem;
    font-size: 1.0625rem;
    font-weight: 600;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    background: linear-gradient(135deg, 
      rgba(236, 72, 153, 0.95),
      rgba(219, 39, 119, 0.95)
    );
    border: none;
    border-radius: 1rem;
    color: white;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 
      0 4px 16px rgba(236, 72, 153, 0.35),
      0 0 24px rgba(236, 72, 153, 0.2);
    position: relative;
    overflow: hidden;
  }
  
  .btn-auth::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, 
      rgba(255, 255, 255, 0.15),
      transparent
    );
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  
  .btn-auth:hover {
    transform: translateY(-3px);
    box-shadow: 
      0 6px 24px rgba(236, 72, 153, 0.45),
      0 0 35px rgba(236, 72, 153, 0.3);
  }
  
  .btn-auth:hover::before {
    opacity: 1;
  }
  
  .btn-auth:active {
    transform: translateY(-1px);
  }
  
  .btn-auth:focus-visible {
    outline: 3px solid rgba(236, 72, 153, 0.4);
    outline-offset: 3px;
  }
  
  .btn-auth svg {
    transition: transform 0.3s ease;
  }
  
  .btn-auth:hover svg {
    transform: translateX(3px);
  }
  
  /* Divider */
  .auth-divider {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin: 2rem 0 1.5rem;
    color: var(--text-tertiary);
    font-size: 0.875rem;
  }
  
  .auth-divider::before,
  .auth-divider::after {
    content: '';
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, 
      transparent,
      rgba(236, 72, 153, 0.2),
      transparent
    );
  }
  
  /* Social Login */
  .social-login {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }
  
  .social-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 1rem;
    background: var(--bg-primary);
    border: 2px solid rgba(236, 72, 153, 0.15);
    border-radius: 1rem;
    color: var(--text-primary);
    font-weight: 600;
    font-size: 0.9375rem;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
  }
  
  .social-btn:hover {
    border-color: rgba(236, 72, 153, 0.3);
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(236, 72, 153, 0.12);
  }
  
  .social-btn:active {
    transform: translateY(0);
  }
  
  [data-theme="dark"] .social-btn {
    background: rgba(10, 10, 15, 0.8);
    border-color: rgba(236, 72, 153, 0.25);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
  }
  
  [data-theme="dark"] .social-btn:hover {
    border-color: rgba(236, 72, 153, 0.4);
    box-shadow: 0 4px 12px rgba(236, 72, 153, 0.15);
  }
  
  /* Auth Footer */
  .auth-footer {
    text-align: center;
    margin-top: 2rem;
    color: var(--text-secondary);
    font-size: 0.9375rem;
  }
  
  .auth-link {
    color: var(--color-primary-600);
    font-weight: 600;
    transition: all 0.3s ease;
  }
  
  .auth-link:hover {
    color: var(--color-primary-700);
    text-decoration: underline;
  }
  
  /* Visual Side - Premium Design */
  .auth-visual {
    display: none;
    position: relative;
  }
  
  @media (min-width: 1024px) {
    .auth-visual {
      display: block;
    }
  }
  
  .visual-content {
    position: relative;
    height: 100%;
    min-height: 600px;
    background: linear-gradient(135deg, 
      rgba(236, 72, 153, 0.95),
      rgba(139, 92, 246, 0.95)
    );
    border-radius: 2rem;
    padding: 4rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    overflow: hidden;
    box-shadow: 
      var(--shadow-xl),
      0 0 80px rgba(236, 72, 153, 0.3);
  }
  
  .visual-gradient {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 30% 50%, 
      rgba(255, 255, 255, 0.15) 0%,
      transparent 60%
    );
    pointer-events: none;
  }
  
  .visual-pattern {
    position: absolute;
    inset: 0;
    background-image: 
      radial-gradient(circle at 20% 80%, rgba(255, 255, 255, 0.1) 0%, transparent 50%),
      radial-gradient(circle at 80% 20%, rgba(255, 255, 255, 0.1) 0%, transparent 50%);
    pointer-events: none;
  }
  
  .visual-text {
    position: relative;
    z-index: 1;
    color: white;
  }
  
  .visual-title {
    font-size: clamp(2rem, 3vw, 3rem);
    font-weight: 800;
    margin-bottom: 1.5rem;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }
  
  .visual-description {
    font-size: 1.125rem;
    line-height: 1.7;
    opacity: 0.95;
    margin-bottom: 3rem;
  }
  
  .visual-features {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  
  .feature-item {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  
  .feature-icon {
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.2);
    border-radius: 50%;
    flex-shrink: 0;
  }
  
  .feature-item span {
    font-size: 1rem;
    font-weight: 500;
  }
  
  .visual-stats {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    padding-top: 3rem;
    border-top: 1px solid rgba(255, 255, 255, 0.2);
  }
  
  .stat-item {
    text-align: center;
    color: white;
  }
  
  .stat-number {
    font-size: 2.5rem;
    font-weight: 800;
    margin-bottom: 0.5rem;
    line-height: 1;
  }
  
  .stat-label {
    font-size: 0.875rem;
    opacity: 0.9;
    font-weight: 500;
  }
  
  /* Responsive */
  @media (max-width: 1023px) {
    .auth-section {
      padding: calc(80px + 2rem) 0 4rem;
    }
    
    .auth-form-wrapper {
      padding: 2rem;
    }
    
    .auth-brand {
      margin-bottom: 2rem;
    }
    
