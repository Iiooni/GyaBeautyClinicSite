---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';

const categories = ['All', 'Facial', 'Body', 'Laser', 'Anti-Aging', 'Cosmetic'];

const galleryItems = [
  {
    id: 1,
    category: 'Facial',
    title: 'Facial Rejuvenation',
    description: 'Deep cleansing and anti-aging treatment',
    duration: '60 min',
    recovery: 'No downtime',
    results: 'Visible in 2 weeks',
    beforeAfter: true,
    beforeImage: 'https://images.unsplash.com/photo-1616394584738-fc6e612e71b9?w=1200&h=900&fit=crop&crop=faces&q=90',
    afterImage: 'https://images.unsplash.com/photo-1515377905703-c4788e51af15?w=1200&h=900&fit=crop&crop=faces&q=90',
    timeline: '8 Weeks'
  },
  {
    id: 2,
    category: 'Laser',
    title: 'Laser Hair Removal',
    description: 'Complete hair removal treatment',
    duration: '45 min',
    recovery: '24 hours',
    results: 'After 6 sessions',
    beforeAfter: true,
    beforeImage: 'https://images.unsplash.com/photo-1560750588-73207b1ef5b8?w=1200&h=900&fit=crop&q=90',
    afterImage: 'https://images.unsplash.com/photo-1522337360788-8b13dee7a37e?w=1200&h=900&fit=crop&q=90',
    timeline: '6 Sessions'
  },
  {
    id: 3,
    category: 'Anti-Aging',
    title: 'Botox Treatment',
    description: 'Wrinkle reduction and skin smoothing',
    duration: '30 min',
    recovery: 'No downtime',
    results: 'Visible in 3-5 days',
    beforeAfter: true,
    beforeImage: 'https://images.unsplash.com/photo-1612349317150-e413f6a5b16d?w=1200&h=900&fit=crop&crop=faces&q=90',
    afterImage: 'https://images.unsplash.com/photo-1559839734-2b71ea197ec2?w=1200&h=900&fit=crop&crop=faces&q=90',
    timeline: '2 Weeks'
  },
  {
    id: 4,
    category: 'Body',
    title: 'Body Contouring',
    description: 'Non-invasive body sculpting',
    duration: '90 min',
    recovery: 'No downtime',
    results: 'After 4 weeks',
    beforeAfter: true,
    beforeImage: 'https://images.unsplash.com/photo-1571019613454-1cb2f99b2d8b?w=1200&h=900&fit=crop&q=90',
    afterImage: 'https://images.unsplash.com/photo-1544161515-4ab6ce6db874?w=1200&h=900&fit=crop&q=90',
    timeline: '4 Weeks'
  },
  {
    id: 5,
    category: 'Cosmetic',
    title: 'Lip Enhancement',
    description: 'Natural-looking lip augmentation',
    duration: '45 min',
    recovery: '48 hours',
    results: 'Immediate',
    beforeAfter: true,
    beforeImage: 'https://images.unsplash.com/photo-1487412947147-5cebf100ffc2?w=1200&h=900&fit=crop&crop=face&q=90',
    afterImage: 'https://images.unsplash.com/photo-1516975080664-ed2fc6a32937?w=1200&h=900&fit=crop&crop=face&q=90',
    timeline: 'Immediate'
  },
  {
    id: 6,
    category: 'Facial',
    title: 'Acne Treatment',
    description: 'Clear skin transformation',
    duration: '60 min',
    recovery: '24 hours',
    results: 'After 8 weeks',
    beforeAfter: true,
    beforeImage: 'https://images.unsplash.com/photo-1614583224978-f05ce51ef5fa?w=1200&h=900&fit=crop&crop=faces&q=90',
    afterImage: 'https://images.unsplash.com/photo-1515377905703-c4788e51af15?w=1200&h=900&fit=crop&crop=faces&q=90',
    timeline: '8 Weeks'
  },
  {
    id: 7,
    category: 'Laser',
    title: 'Skin Resurfacing',
    description: 'Laser skin rejuvenation',
    duration: '75 min',
    recovery: '3-5 days',
    results: 'After 2 weeks',
    beforeAfter: true,
    beforeImage: 'https://images.unsplash.com/photo-1438761681033-6461ffad8d80?w=1200&h=900&fit=crop&crop=faces&q=90',
    afterImage: 'https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=1200&h=900&fit=crop&crop=faces&q=90',
    timeline: '2 Weeks'
  },
  {
    id: 8,
    category: 'Anti-Aging',
    title: 'Dermal Fillers',
    description: 'Volume restoration and contouring',
    duration: '45 min',
    recovery: 'No downtime',
    results: 'Immediate',
    beforeAfter: true,
    beforeImage: 'https://images.unsplash.com/photo-1500648767791-00dcc994a43e?w=1200&h=900&fit=crop&crop=faces&q=90',
    afterImage: 'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=1200&h=900&fit=crop&crop=faces&q=90',
    timeline: 'Immediate'
  },
  {
    id: 9,
    category: 'Body',
    title: 'Cellulite Reduction',
    description: 'Smooth skin transformation',
    duration: '60 min',
    recovery: 'No downtime',
    results: 'After 6 weeks',
    beforeAfter: true,
    beforeImage: 'https://images.unsplash.com/photo-1559827260-dc66d52bef19?w=1200&h=900&fit=crop&q=90',
    afterImage: 'https://images.unsplash.com/photo-1540555700478-4be289fbecef?w=1200&h=900&fit=crop&q=90',
    timeline: '6 Weeks'
  }
];
---

<BaseLayout 
  title="Gallery - Beauty Clinic"
  description="View our stunning before and after transformations. See real results from our expert treatments and procedures."
>
  <Header />
  
  <main>
    <!-- Page Header -->
    <section class="page-header">
      <div class="container">
        <h1 class="page-title animate-fade-in-up">Our Gallery</h1>
        <p class="page-subtitle animate-fade-in-up stagger-1">
          Real results from real clients - see the transformations
        </p>
      </div>
    </section>
    
    <!-- Filter Section -->
    <section class="filter-section">
      <div class="container">
        <div class="filter-buttons reveal" id="filterButtons">
          {categories.map((category, index) => (
            <button 
              class={`filter-btn ${index === 0 ? 'active' : ''}`}
              data-filter={category.toLowerCase()}
            >
              {category}
            </button>
          ))}
        </div>
      </div>
    </section>
    
    <!-- Gallery Grid -->
    <section class="gallery-section">
      <div class="container">
        <div class="gallery-grid" id="galleryGrid">
          {galleryItems.map((item, index) => (
            <div 
              class={`gallery-item card hover-lift reveal stagger-${(index % 6) + 1}`}
              data-category={item.category.toLowerCase()}
            >
              <div class="gallery-image-wrapper">
                {item.beforeAfter && (
                  <div class="before-after-container">
                    <div class="image-side before">
                      <div class="image-placeholder">
                        <img 
                          src={item.beforeImage} 
                          alt={`${item.title} - Before`}
                          class="comparison-image"
                          loading="lazy"
                        />
                      </div>
                      <span class="label">Before</span>
                      <span class="timeline-label">Before Treatment</span>
                    </div>
                    <div class="divider">
                      <div class="divider-line"></div>
                      <div class="divider-handle">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                          <polyline points="15 18 9 12 15 6"></polyline>
                          <polyline points="9 18 15 12 9 6"></polyline>
                        </svg>
                      </div>
                    </div>
                    <div class="image-side after">
                      <div class="image-placeholder">
                        <img 
                          src={item.afterImage} 
                          alt={`${item.title} - After`}
                          class="comparison-image"
                          loading="lazy"
                        />
                      </div>
                      <span class="label after-label">After</span>
                      <span class="timeline-label">After {item.timeline}</span>
                    </div>
                  </div>
                )}
              </div>
              
              <div class="gallery-content">
                <span class="gallery-category">{item.category}</span>
                <h3 class="gallery-title">{item.title}</h3>
                <p class="gallery-description">{item.description}</p>
                
                <div class="gallery-divider"></div>
                
                <div class="gallery-meta">
                  <div class="meta-item">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <circle cx="12" cy="12" r="10"></circle>
                      <polyline points="12 6 12 12 16 14"></polyline>
                    </svg>
                    <span>{item.duration}</span>
                  </div>
                  <div class="meta-item">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                      <polyline points="22 4 12 14.01 9 11.01"></polyline>
                    </svg>
                    <span>{item.recovery}</span>
                  </div>
                  <div class="meta-item">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline>
                    </svg>
                    <span>{item.results}</span>
                  </div>
                </div>
                
                <div class="gallery-button-divider"></div>
                
                <a href="/booking" class="gallery-btn">
                  <span>View Case Study</span>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                  </svg>
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
    
    <!-- Stats Section -->
    <section class="stats-bar">
      <div class="container">
        <div class="stats-grid">
          <div class="stat-item">
            <div class="stat-number">500+</div>
            <div class="stat-label">Successful Transformations</div>
          </div>
          <div class="stat-item">
            <div class="stat-number">98%</div>
            <div class="stat-label">Client Satisfaction</div>
          </div>
          <div class="stat-item">
            <div class="stat-number">15+</div>
            <div class="stat-label">Years Experience</div>
          </div>
          <div class="stat-item">
            <div class="stat-number">100%</div>
            <div class="stat-label">Licensed Professionals</div>
          </div>
        </div>
      </div>
    </section>
    
    <!-- CTA Section -->
    <section class="cta-section">
      <div class="container">
        <div class="cta-content reveal-scale">
          <h2 class="cta-title">Ready for Your Transformation?</h2>
          <p class="cta-text">
            Join hundreds of satisfied clients and start your beauty journey today.
          </p>
          <div class="cta-buttons">
            <a href="/booking" class="btn btn-primary btn-large hover-lift">Book Appointment</a>
            <a href="/contact" class="btn btn-secondary btn-large hover-lift">Contact Us</a>
          </div>
          
          <div class="cta-benefits">
            <div class="benefit-item">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span>Free Consultation</span>
            </div>
            <div class="benefit-item">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span>No Obligation</span>
            </div>
            <div class="benefit-item">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span>Expert Advice</span>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
  
  <Footer />
</BaseLayout>

<style>
  /* Hero Section - Premium Enhancement */
  .page-header {
    padding: calc(80px + 6rem) 0 7rem;
    background: linear-gradient(135deg, 
      rgba(168, 85, 247, 0.15) 0%,
      rgba(219, 39, 119, 0.15) 50%,
      rgba(249, 115, 22, 0.12) 100%
    );
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  
  .page-header::before {
    content: '';
    position: absolute;
    inset: 0;
    background: 
      radial-gradient(circle at 50% 50%, rgba(236, 72, 153, 0.08) 0%, transparent 70%),
      radial-gradient(ellipse at top, rgba(0, 0, 0, 0.02) 0%, transparent 50%),
      radial-gradient(ellipse at bottom, rgba(0, 0, 0, 0.03) 0%, transparent 50%);
    pointer-events: none;
  }
  
  [data-theme="dark"] .page-header {
    background: linear-gradient(135deg, 
      rgba(88, 28, 135, 0.4) 0%,
      rgba(136, 19, 55, 0.4) 50%,
      rgba(154, 52, 18, 0.3) 100%
    );
  }
  
  [data-theme="dark"] .page-header::before {
    background: 
      radial-gradient(circle at 50% 50%, rgba(236, 72, 153, 0.12) 0%, transparent 70%),
      radial-gradient(ellipse at top, rgba(0, 0, 0, 0.3) 0%, transparent 50%),
      radial-gradient(ellipse at bottom, rgba(0, 0, 0, 0.4) 0%, transparent 50%);
  }
  
  .page-title {
    font-size: clamp(2.5rem, 5vw, 4rem);
    margin-bottom: 1.5rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.1;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    position: relative;
    z-index: 1;
  }
  
  [data-theme="dark"] .page-title {
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.3);
  }
  
  .page-subtitle {
    font-size: clamp(1.125rem, 2vw, 1.5rem);
    color: var(--text-secondary);
    opacity: var(--text-opacity-secondary);
    max-width: 700px;
    margin: 0 auto;
    line-height: 1.6;
    font-weight: 400;
    position: relative;
    z-index: 1;
  }
  
  /* Filter Section - Premium Enhancement */
  .filter-section {
    background: var(--bg-secondary);
    padding: 2.5rem 0;
  }
  
  .filter-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
  }
  
  .filter-btn {
    padding: 0.75rem 1.75rem;
    border: 1px solid rgba(236, 72, 153, 0.15);
    border-radius: 999px;
    background: linear-gradient(135deg, 
      rgba(236, 72, 153, 0.04),
      rgba(139, 92, 246, 0.04)
    );
    backdrop-filter: blur(8px);
    color: var(--text-secondary);
    font-weight: 600;
    font-size: 0.9375rem;
    cursor: pointer;
    transition: all var(--transition-base);
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.04);
    position: relative;
    overflow: hidden;
  }
  
  .filter-btn::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, 
      rgba(236, 72, 153, 0.1),
      rgba(139, 92, 246, 0.1)
    );
    opacity: 0;
    transition: opacity var(--transition-base);
  }
  
  .filter-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(236, 72, 153, 0.15);
    border-color: rgba(236, 72, 153, 0.25);
  }
  
  .filter-btn:hover::before {
    opacity: 1;
  }
  
  .filter-btn.active {
    background: linear-gradient(135deg, 
      rgba(236, 72, 153, 0.9),
      rgba(219, 39, 119, 0.9)
    );
    border-color: rgba(236, 72, 153, 0.5);
    color: white;
    box-shadow: 
      0 4px 12px rgba(236, 72, 153, 0.3),
      0 0 20px rgba(236, 72, 153, 0.15);
    transform: translateY(-2px);
  }
  
  .filter-btn.active::before {
    opacity: 0;
  }
  
  [data-theme="dark"] .filter-btn {
    background: linear-gradient(135deg, 
      rgba(236, 72, 153, 0.08),
      rgba(139, 92, 246, 0.08)
    );
    border-color: rgba(236, 72, 153, 0.2);
  }
  
  [data-theme="dark"] .filter-btn:hover {
    box-shadow: 0 4px 12px rgba(236, 72, 153, 0.2);
    border-color: rgba(236, 72, 153, 0.35);
  }
  
  [data-theme="dark"] .filter-btn.active {
    background: linear-gradient(135deg, 
      rgba(236, 72, 153, 0.95),
      rgba(219, 39, 119, 0.95)
    );
    box-shadow: 
      0 4px 12px rgba(236, 72, 153, 0.4),
      0 0 25px rgba(236, 72, 153, 0.2);
  }
  
  /* Gallery Section - Premium Enhancement */
  .gallery-section {
    background: var(--bg-primary);
    padding: 6.25rem 0; /* 100px consistent spacing */
  }
  
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
    gap: 2rem; /* 32px consistent spacing */
  }
  
  .gallery-item {
    overflow: hidden;
    transition: all var(--transition-base);
    background: var(--bg-secondary);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-sm);
    border: 1px solid rgba(236, 72, 153, 0.08);
    min-height: 620px;
    display: flex;
    flex-direction: column;
    position: relative;
  }
  
  .gallery-item::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, 
      rgba(236, 72, 153, 0.02) 0%,
      rgba(139, 92, 246, 0.02) 100%
    );
    opacity: 0;
    transition: opacity var(--transition-base);
    pointer-events: none;
    z-index: 0;
  }
  
  .gallery-item:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-md);
    border-color: rgba(236, 72, 153, 0.2);
  }
  
  .gallery-item:hover::before {
    opacity: 1;
  }
  
  .gallery-item:hover .before-after-container {
    transform: scale(1.02);
  }
  
  .gallery-item:hover .gallery-btn {
    border-color: rgba(236, 72, 153, 0.6);
    box-shadow: 0 6px 16px rgba(236, 72, 153, 0.25);
  }
  
  [data-theme="dark"] .gallery-item {
    background: var(--bg-secondary);
    border-color: rgba(236, 72, 153, 0.12);
  }
  
  [data-theme="dark"] .gallery-item:hover {
    box-shadow: var(--shadow-md), 0 0 35px rgba(236, 72, 153, 0.15);
    border-color: rgba(236, 72, 153, 0.3);
  }
  
  .gallery-item.hidden {
    display: none;
  }
  
  .gallery-image-wrapper {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-xl) var(--radius-xl) 0 0;
    margin-bottom: 0;
  }
  
  .before-after-container {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 0;
    background: var(--bg-tertiary);
    transition: transform var(--transition-base);
    position: relative;
  }
  
  .before-after-container::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, 
      rgba(0, 0, 0, 0.02) 0%,
      transparent 50%,
      rgba(0, 0, 0, 0.03) 100%
    );
    pointer-events: none;
    z-index: 1;
  }
  
  [data-theme="dark"] .before-after-container::before {
    background: linear-gradient(180deg, 
      rgba(0, 0, 0, 0.3) 0%,
      transparent 50%,
      rgba(0, 0, 0, 0.4) 100%
    );
  }
  
  .image-side {
    position: relative;
    overflow: hidden;
  }
  
  .image-placeholder {
    width: 100%;
    aspect-ratio: 4/3;
    position: relative;
    overflow: hidden;
  }
  
  .comparison-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }
  
  .image-placeholder svg {
    width: 100%;
    height: 100%;
    display: block;
  }
  
  .label {
    position: absolute;
    top: 0.875rem;
    left: 0.875rem;
    background: rgba(0, 0, 0, 0.75);
    backdrop-filter: blur(8px);
    color: white;
    padding: 0.5rem 1rem;
    border-radius: 999px;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
    z-index: 2;
  }
  
  .label.after-label {
    background: linear-gradient(135deg, 
      rgba(236, 72, 153, 0.95),
      rgba(219, 39, 119, 0.95)
    );
    box-shadow: 
      0 4px 12px rgba(236, 72, 153, 0.5),
      0 0 20px rgba(236, 72, 153, 0.3),
      0 0 0 1px rgba(255, 255, 255, 0.2);
  }
  
  [data-theme="dark"] .label {
    background: rgba(0, 0, 0, 0.85);
  }
  
  [data-theme="dark"] .label.after-label {
    background: linear-gradient(135deg, 
      rgba(236, 72, 153, 1),
      rgba(219, 39, 119, 1)
    );
    box-shadow: 
      0 4px 12px rgba(236, 72, 153, 0.6),
      0 0 25px rgba(236, 72, 153, 0.4),
      0 0 0 1px rgba(255, 255, 255, 0.3);
  }
  
  .divider {
    position: relative;
    width: 2px;
    background: linear-gradient(180deg, 
      rgba(255, 255, 255, 0.8),
      rgba(255, 255, 255, 0.95),
      rgba(255, 255, 255, 0.8)
    );
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 
      0 0 8px rgba(255, 255, 255, 0.5),
      0 0 16px rgba(236, 72, 153, 0.2),
      0 4px 8px rgba(0, 0, 0, 0.1);
  }
  
  [data-theme="dark"] .divider {
    background: linear-gradient(180deg, 
      rgba(236, 72, 153, 0.8),
      rgba(236, 72, 153, 0.95),
      rgba(236, 72, 153, 0.8)
    );
    box-shadow: 
      0 0 12px rgba(236, 72, 153, 0.6),
      0 0 20px rgba(236, 72, 153, 0.3),
      0 4px 8px rgba(0, 0, 0, 0.2);
  }
  
  .divider-handle {
    position: absolute;
    width: 40px;
    height: 40px;
    background: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 
      0 4px 16px rgba(0, 0, 0, 0.15),
      0 0 0 3px rgba(236, 72, 153, 0.2),
      inset 0 1px 0 rgba(255, 255, 255, 0.8);
    color: var(--color-primary-500);
    transition: all var(--transition-base);
    cursor: ew-resize;
    z-index: 2;
  }
  
  .gallery-item:hover .divider-handle {
    transform: scale(1.08);
    box-shadow: 
      0 6px 20px rgba(0, 0, 0, 0.2),
      0 0 0 4px rgba(236, 72, 153, 0.3),
      0 0 20px rgba(236, 72, 153, 0.2),
      inset 0 1px 0 rgba(255, 255, 255, 0.8);
  }
  
