---

<BaseLayout 
  title="Beauty Clinic - Premium Beauty & Wellness Treatments | Transform Your Natural Beauty"
  description="Experience world-class beauty treatments with our expert team. FDA-approved procedures, 18+ years experience, 12,500+ satisfied clients. Book your free consultation today."
>
  <style>
    @import '../styles/homepage.css';
  </style>
  
  <Header />
  
  <main>
    <Hero 
      title="Nottinghamshire Aesthetics Practitioner "
      subtitle="Carefully placed filler treatments and PRP, tailored to you and the result you actually want."
      subtitle2="Honest advice and treatments that make sense. "
      subtitle3=""
    />

    <!-- Section Before And After Begin-->
