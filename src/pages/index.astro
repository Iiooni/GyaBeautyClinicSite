    <!-- Services Section -->
    <section class="services-section">
      <div class="container">
        <div class="section-header reveal">
          <h2 class="featured-post card decor-text "> Is about what makes you happy 
</h2>
          <h2 class="treatments-title index-padding">Our beauty treatments</h2>
          <p class="section-subtitle">
            treatments 
          </p>
        </div>
        
        <div class="services-grid">
          {services.map((service, index) => (
            <div class={`service-card card hover-lift reveal stagger-${(index % 6) + 1}`}>
              {service.popular && (
                <div class="popular-badge">
                  <span class="badge-icon">⭐</span>
                  <span>Most Popular</span>
                </div>
              )}
              
              <div class="service-image-wrapper">
                <img src={service.image} alt={service.title} class="service-image" loading="lazy" />
                <div class="service-overlay"></div>
              </div>
              
              <h3 class="service-title">{service.title}</h3>
              <p class="service-description">{service.description}</p>
              
              <div class="service-features">
                {service.features.map(feature => (
                  <span class="feature-tag">{feature}</span>
                ))}
              </div>
              
              <div class="service-footer">
                <div class="service-price">
                  <span class="price-label">Starting at</span>
                  <span class="price-value">{service.price}</span>
                </div>
                <a href={service.link} class="service-link">
                  <span>Learn More</span>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                  </svg>
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Why Choose Us Section -->
    <section class="why-choose-section">
      <div class="container">
        <div class="section-header reveal">
          <span class="section-badge">Why Choose Us</span>
          <h2 class="section-title">Excellence in Every Treatment</h2>
          <p class="section-subtitle">
            Discover why hundreds of clients trust us with their beauty transformation journey.
          </p>
        </div>
        
        <div class="why-choose-grid">
          <div class="why-choose-content reveal">
            <p class="section-text">
              We specialize in injectables that are placed at exactly the right depth, because that’s what creates the most natural, long-lasting results.
              Led by Gya, an experienced aesthetic nurse with over a decade of hands-on expertise, at Gya Aesthetic Style, every treatment is done with expert precision and an artist’s eye.


            </p>
            
            <div class="why-features">
              <div class="why-feature-item hover-lift">
                <div class="feature-icon">
                  <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                    <polyline points="9 22 9 12 15 12 15 22"></polyline>
                    <path d="M9 2v4"></path>
                    <path d="M15 2v4"></path>
                  </svg>
                </div>
                <div class="feature-content">
                  <h4>Medical-Grade Excellence</h4>
                  <p>FDA-approved equipment and pharmaceutical-grade products used in all treatments.</p>
                </div>
              </div>
              
              <div class="why-feature-item hover-lift">
                <div class="feature-icon">
                  <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                    <circle cx="12" cy="7" r="4"></circle>
                    <path d="M12 14v-2"></path>
                    <path d="M12 8V6"></path>
                  </svg>
                </div>
                <div class="feature-content">
                  <h4>Expert Medical Team</h4>
                  <p>Board-certified practicioner and licensed specialist with extensive training and experience.</p>
                </div>
              </div>
              
              <div class="why-feature-item hover-lift">
                <div class="feature-icon">
                  <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"></circle>
                    <path d="M12 6v6l4 2"></path>
                    <path d="M16.24 7.76l-1.41 1.41"></path>
                    <path d="M7.76 16.24l1.41-1.41"></path>
                  </svg>
                </div>
                <div class="feature-content">
                  <h4>Advanced Technology</h4>
                  <p>State-of-the-art equipment and latest treatment techniques for optimal results.</p>
                </div>
              </div>
              
              <div class="why-feature-item hover-lift">
                <div class="feature-icon">
                  <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path>
                  </svg>
                </div>
                <div class="feature-content">
                  <h4>Personalized Care</h4>
                  <p>Customized treatment plans tailored to your unique needs and beauty goals.</p>
                </div>
              </div>
            </div>
            
            <!--<a href="/about" class="btn btn-primary hover-lift"> -->
            <a href="#" class="btn btn-primary hover-lift">
              <span>Learn More About Us</span>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
          </div>
          
          <div class="why-choose-visual reveal">
            <div class="why-stats">
              <div class="why-stat">
                <span class="stat-number counter" data-target="7">7+</span>
                <span class="stat-label">Years Experience</span>
              </div>
              <div class="why-stat">
                <span class="stat-number counter" data-target="200">200</span>
                <span >+</span>
                <span class="stat-label">Happy Clients</span>
              </div>
              <div class="why-stat">
                <span class="stat-number counter" data-target="98">98</span>
                <span class="stat-label">Satisfaction Rate</span>
              </div>
            </div>
            
            <div class="visual-card card" style="margin-top: 2rem;">
              <div class="visual-image-wrapper">
                <img 
                  src="../images/clinic/care_shows_4.png" 
                  alt="Professional beauty clinic consultation" 
                  class="visual-image"
                  loading="lazy"
                />
                <div class="visual-overlay"></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Before & After Section -->
    <!-- 
    <section class="before-after-section">
      <div class="container">
        <div class="section-header reveal">
          <span class="section-badge">Client Results</span>
          <h2 class="section-title">Before & After</h2>
          <p class="section-subtitle">
            See the remarkable transformations our clients have achieved with our expert treatments.
          </p>
        </div>
        
        <div class="before-after-slider reveal">
          <div class="comparison-card card">
            <div class="comparison-header">
              <h3>Deep Wrinkles and Fine Lines</h3>
              <span class="treatment-badge">lasts up to 5 months</span>
            </div>
            
            <div class="comparison-images">
              <div class="image-side">
                <span class="image-label">Before</span>
                <div class="image-placeholder">
                  <img src="../images/before-after/before_1.png" alt="Before Treatment" loading="lazy" />
                </div>
              </div>
              
              <div class="divider-line"></div>
              
              <div class="image-side">
                <span class="image-label after">After</span>
                <div class="image-placeholder">
                  <img src="../images/before-after/after_1.png" alt="After Treatment" loading="lazy" />
                </div>
              </div>
            </div>
            
            <div class="comparison-footer">
              <p>
                <strong>Treatment:</strong> Advanced Deep Wrinkles and Fine Lines • 
                <strong>Duration:</strong> lasts up to 5 months • 
                <strong>Sessions:</strong> 1 treatment
              </p>
            </div>
          </div>
        </div>
        
        <div class="before-after-cta">
           <a href="/gallery" class="btn btn-primary btn-large hover-lift">
            <span>View Full Gallery</span>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>
      </div>
    </section>
    -->

   

    <!-- Meet Our Doctors Section -->
    <section class="doctors-preview-section">
      <div class="container">
        <div class="section-header reveal">
          <span class="section-badge">Gya</span>
          <h2 class="section-title">Meet Gya</h2>
          <p class="section-subtitle">
            Board-certified specialist dedicated to delivering exceptional results with personalized care.
          </p>
        </div>
        
        <div class="doctors-preview-grid">
          {doctors.map((doctor, index) => (
            <div class={`doctor-preview-card card hover-lift reveal stagger-${(index % 3) + 1}`}>
              <span class="doctor-badge">{doctor.experience}</span>
              <div class="doctor-avatar-large">
                <img src={doctor.avatar} alt={doctor.name} loading="lazy" />
              </div>
              <h3 class="doctor-name">{doctor.name}</h3>
              <p class="doctor-specialty">{doctor.specialty}</p>
              <p class="doctor-credentials">{doctor.credentials}</p>
            </div>
          ))}
        </div>
        
        <div class="doctors-cta">
          <!--<a href="/doctors" class="btn btn-primary btn-large hover-lift"> -->
          <a href="#" class="btn btn-primary btn-large hover-lift">
            <span>Find more about Gya</span>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>
      </div>
    </section>

    <!-- Testimonials Section -->
    <section class="testimonials-section">
      <div class="container">
        <div class="section-header reveal">
          <span class="section-badge">Client Stories</span>
          <h2 class="section-title">What Our Clients Say</h2>
          <p class="section-subtitle">
            Real experiences from real people who have transformed their lives with our treatments.
          </p>
        </div>
        
        <div class="testimonials-grid">
          {testimonials.map((testimonial, index) => (
            <div class={`testimonial-card card hover-lift reveal stagger-${(index % 3) + 1}`}>
              <div class="testimonial-header">
                <div class="testimonial-rating">
                  {Array.from({ length: testimonial.rating }).map(() => (
                    <span class="star">⭐</span>
                  ))}
                </div>
                {testimonial.verified && (
                  <div class="verified-badge">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                    <span>Verified</span>
                  </div>
                )}
              </div>
              
              <p class="testimonial-text">{testimonial.text}</p>
              
              <div class="testimonial-author">
                <div class="author-avatar">
                  <img src={testimonial.avatar} alt={testimonial.name} loading="lazy" />
                </div>
                <div class="author-info">
                  <div class="author-name">{testimonial.name}</div>
                  <div class="author-role">{testimonial.role}</div>
                  <div class="author-treatment">{testimonial.treatment}</div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Pricing Packages Section -->
    <section class="pricing-section">
      <div class="container">
        <div class="section-header reveal">
          <span class="section-badge">Investment</span>
          <h2 class="section-title">Flexible Pricing Packages</h2>
          <p class="section-subtitle">
            Choose the perfect package that fits your beauty goals and budget. All packages include expert consultation.
          </p>
        </div>
        
        <div class="pricing-grid">
          {pricingPackages.map((pkg, index) => (
            <div class={`pricing-card card hover-lift reveal stagger-${(index % 3) + 1} ${pkg.popular ? 'popular' : ''}`}>
              {pkg.popular && (
                <div class="popular-ribbon">Most Popular</div>
              )}
              
              <div class="pricing-visual">
                <svg viewBox="0 0 300 120" xmlns="http://www.w3.org/2000/svg">
                  <defs>
                    <linearGradient id={`pricingGrad${index}`} x1="0%" y1="0%" x2="100%" y2="100%">
                      <stop offset="0%" style={`stop-color:${index === 0 ? '#ec4899' : index === 1 ? '#8b5cf6' : '#f97316'};stop-opacity:0.2`} />
                      <stop offset="100%" style={`stop-color:${index === 0 ? '#f97316' : index === 1 ? '#ec4899' : '#8b5cf6'};stop-opacity:0.2`} />
                    </linearGradient>
                  </defs>
                  <rect width="300" height="120" fill={`url(#pricingGrad${index})`} rx="12"/>
                  <circle cx="60" cy="60" r="30" fill={`url(#pricingGrad${index})`} opacity="0.5"/>
                  <circle cx="150" cy="60" r="35" fill={`url(#pricingGrad${index})`} opacity="0.6"/>
                  <circle cx="240" cy="60" r="30" fill={`url(#pricingGrad${index})`} opacity="0.5"/>
                  <text x="150" y="70" text-anchor="middle" font-size="48" fill={index === 0 ? '#ec4899' : index === 1 ? '#8b5cf6' : '#f97316'} opacity="0.6">
                    {index === 0 ? '✨' : index === 1 ? '💎' : '👑'}
                  </text>
                </svg>
              </div>
              
              <div class="pricing-header">
                <h3 class="package-name">{pkg.name}</h3>
                <p class="package-description">{pkg.description}</p>
              </div>
              
              <div class="pricing-price">
                <span class="price-amount">{pkg.price}</span>
                <span class="price-period">{pkg.period}</span>
