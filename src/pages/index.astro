    <!-- Section Before And After End -->


    <!-- Video Client And Gya Begin -->
     <!-- 
     <div class="video-client-gya">
      <video width="300" height="400" muted="" autoplay=""  id="video" class="video-in-viewport w-full h-full object-cover "> 
