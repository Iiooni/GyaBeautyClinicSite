---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';

const jobOpenings = [
  {
    id: 'senior-aesthetician',
    title: 'Senior Aesthetician',
    department: 'Clinical',
    location: 'New York, NY',
    type: 'Full-time',
    experience: '5+ years',
    description: 'Lead our facial treatment team and deliver exceptional client experiences.',
    responsibilities: [
      'Perform advanced facial treatments and consultations',
      'Train and mentor junior aestheticians',
      'Develop customized treatment plans',
      'Maintain highest standards of client care'
    ],
    requirements: [
      'Licensed Aesthetician with 5+ years experience',
      'Advanced training in facial treatments',
      'Excellent communication skills',
      'Passion for skincare and client satisfaction'
    ]
  },
  {
    id: 'laser-technician',
    title: 'Laser Technician',
    department: 'Clinical',
    location: 'New York, NY',
    type: 'Full-time',
    experience: '3+ years',
    description: 'Operate advanced laser equipment and provide safe, effective treatments.',
    responsibilities: [
      'Perform laser hair removal and skin treatments',
      'Conduct client consultations and assessments',
      'Maintain laser equipment and safety protocols',
      'Document treatment progress and results'
    ],
    requirements: [
      'Certified Laser Technician',
      '3+ years of laser treatment experience',
      'Strong attention to detail',
      'Commitment to safety and protocols'
    ]
  },
  {
    id: 'front-desk-coordinator',
    title: 'Front Desk Coordinator',
    department: 'Operations',
    location: 'New York, NY',
    type: 'Full-time',
    experience: '2+ years',
    description: 'Be the welcoming face of our clinic and manage client experiences.',
    responsibilities: [
      'Greet clients and manage appointments',
      'Handle phone inquiries and bookings',
      'Process payments and maintain records',
      'Coordinate with clinical team'
    ],
    requirements: [
      '2+ years in customer service or hospitality',
      'Excellent organizational skills',
      'Professional communication',
      'Experience with booking systems preferred'
    ]
  },
  {
    id: 'marketing-manager',
    title: 'Marketing Manager',
    department: 'Marketing',
    location: 'New York, NY',
    type: 'Full-time',
    experience: '4+ years',
    description: 'Drive our brand growth and digital marketing strategies.',
    responsibilities: [
      'Develop and execute marketing campaigns',
      'Manage social media and content strategy',
      'Analyze marketing metrics and ROI',
      'Collaborate with clinical team on promotions'
    ],
    requirements: [
      '4+ years in marketing, preferably beauty/wellness',
      'Strong digital marketing skills',
      'Creative and analytical mindset',
      'Experience with social media management'
    ]
  },
  {
    id: 'nurse-practitioner',
    title: 'Nurse Practitioner',
    department: 'Clinical',
    location: 'New York, NY',
    type: 'Full-time',
    experience: '3+ years',
    description: 'Provide advanced aesthetic treatments and medical consultations.',
    responsibilities: [
      'Perform injectable treatments (Botox, fillers)',
      'Conduct medical consultations',
      'Develop treatment protocols',
      'Ensure compliance with medical standards'
    ],
    requirements: [
      'Licensed Nurse Practitioner',
      '3+ years in aesthetic medicine',
      'Injectable certification required',
      'Strong clinical judgment'
    ]
  },
  {
    id: 'spa-manager',
    title: 'Spa Manager',
    department: 'Operations',
    location: 'New York, NY',
    type: 'Full-time',
    experience: '5+ years',
    description: 'Oversee daily operations and lead our exceptional team.',
    responsibilities: [
      'Manage clinic operations and staff',
      'Ensure exceptional client experiences',
      'Handle scheduling and inventory',
      'Drive business growth and efficiency'
    ],
    requirements: [
      '5+ years in spa/clinic management',
      'Strong leadership skills',
      'Business acumen and P&L experience',
      'Passion for wellness industry'
    ]
  }
];

const benefits = [
  {
    icon: '💰',
    title: 'Competitive Salary',
    description: 'Industry-leading compensation packages with performance bonuses'
  },
  {
    icon: '🏥',
    title: 'Health Benefits',
    description: 'Comprehensive medical, dental, and vision insurance coverage'
  },
  {
    icon: '🌴',
    title: 'Paid Time Off',
    description: 'Generous vacation days, sick leave, and paid holidays'
  },
  {
    icon: '📚',
    title: 'Professional Development',
    description: 'Continuous training, certifications, and career advancement'
  },
  {
    icon: '✨',
    title: 'Treatment Discounts',
    description: 'Exclusive discounts on all services and products'
  },
  {
    icon: '🎯',
    title: 'Growth Opportunities',
    description: 'Clear career paths and promotion from within culture'
  }
];

const cultureValues = [
  {
    title: 'Excellence',
    description: 'We strive for the highest standards in everything we do'
  },
  {
    title: 'Innovation',
    description: 'We embrace new technologies and treatment methods'
  },
  {
    title: 'Compassion',
    description: 'We care deeply about our clients and each other'
  },
  {
    title: 'Integrity',
    description: 'We operate with honesty and transparency'
  }
];

const applicationProcess = [
  {
    step: 1,
    title: 'Apply Online',
    description: 'Submit your resume and cover letter through our application form'
  },
  {
    step: 2,
    title: 'Initial Review',
    description: 'Our HR team reviews your application within 5 business days'
  },
  {
    step: 3,
    title: 'Interview',
    description: 'Selected candidates meet with our hiring team'
  },
  {
    step: 4,
    title: 'Offer & Onboarding',
    description: 'Successful candidates receive offers and join our team'
  }
];
---

<BaseLayout 
  title="Careers - Join Our Team - Beauty Clinic"
  description="Join our team of passionate professionals. Explore career opportunities in aesthetic medicine, skincare, and wellness at our premium beauty clinic."
>
  <Header />
  
  <main>
    <!-- Hero Section -->
    <section class="careers-hero">
      <div class="container">
        <div class="hero-content">
          <div class="hero-badge">Join Our Team</div>
          <h1 class="hero-title">Build Your Career in Beauty & Wellness</h1>
          <p class="hero-description">
            Join a team of passionate professionals dedicated to transforming lives through 
            exceptional aesthetic care. We're looking for talented individuals who share our 
            commitment to excellence and innovation.
          </p>
          <div class="hero-stats">
            <div class="stat-item">
              <div class="stat-number">50+</div>
              <div class="stat-label">Team Members</div>
            </div>
            <div class="stat-item">
              <div class="stat-number">15+</div>
              <div class="stat-label">Years Experience</div>
            </div>
            <div class="stat-item">
              <div class="stat-number">98%</div>
              <div class="stat-label">Employee Satisfaction</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Benefits Section -->
    <section class="benefits-section">
      <div class="container">
        <div class="section-header">
          <h2 class="section-title">Why Work With Us</h2>
          <p class="section-subtitle">Comprehensive benefits and a supportive work environment</p>
        </div>
        
        <div class="benefits-grid">
          {benefits.map((benefit, index) => (
            <div class={`benefit-card card reveal stagger-${(index % 3) + 1}`}>
              <div class="benefit-icon">{benefit.icon}</div>
              <h3 class="benefit-title">{benefit.title}</h3>
              <p class="benefit-description">{benefit.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Job Openings Section -->
    <section class="jobs-section">
      <div class="container">
        <div class="section-header">
          <h2 class="section-title">Open Positions</h2>
          <p class="section-subtitle">Explore opportunities to join our growing team</p>
        </div>
        
        <div class="jobs-list">
          {jobOpenings.map((job, index) => (
            <div class={`job-card card reveal stagger-${(index % 2) + 1}`}>
              <div class="job-header">
                <div class="job-main">
                  <h3 class="job-title">{job.title}</h3>
                  <div class="job-meta">
                    <span class="job-department">{job.department}</span>
                    <span class="meta-divider">•</span>
                    <span class="job-location">{job.location}</span>
                    <span class="meta-divider">•</span>
                    <span class="job-type">{job.type}</span>
                  </div>
                </div>
                <div class="job-experience">{job.experience}</div>
              </div>
              
              <p class="job-description">{job.description}</p>
              
              <div class="job-details">
                <div class="detail-section">
                  <h4 class="detail-title">Key Responsibilities:</h4>
                  <ul class="detail-list">
                    {job.responsibilities.slice(0, 3).map(item => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </div>
                
                <div class="detail-section">
                  <h4 class="detail-title">Requirements:</h4>
                  <ul class="detail-list">
                    {job.requirements.slice(0, 3).map(item => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </div>
              </div>
              
              <a href={`/careers/apply?job=${job.id}`} class="btn btn-primary">
                Apply Now
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </a>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Culture Section -->
    <section class="culture-section">
      <div class="container">
        <div class="section-header">
          <h2 class="section-title">Our Culture & Values</h2>
          <p class="section-subtitle">The principles that guide everything we do</p>
        </div>
        
        <div class="culture-grid">
          {cultureValues.map((value, index) => (
            <div class={`culture-card card reveal stagger-${index + 1}`}>
              <h3 class="culture-title">{value.title}</h3>
              <p class="culture-description">{value.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Application Process Section -->
    <section class="process-section">
      <div class="container">
        <div class="section-header">
          <h2 class="section-title">Application Process</h2>
          <p class="section-subtitle">Your journey to joining our team</p>
        </div>
        
        <div class="process-timeline">
          {applicationProcess.map((item, index) => (
            <div class={`process-step reveal stagger-${index + 1}`}>
              <div class="step-number">{item.step}</div>
              <div class="step-content">
                <h3 class="step-title">{item.title}</h3>
                <p class="step-description">{item.description}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="cta-section">
      <div class="container">
        <div class="cta-content">
          <h2 class="cta-title">Ready to Start Your Journey?</h2>
          <p class="cta-text">
            Don't see the perfect role? Send us your resume and we'll keep you in mind for future opportunities.
          </p>
          <a href="/contact" class="btn btn-secondary btn-large">
            Get in Touch
          </a>
        </div>
      </div>
    </section>
  </main>
  
  <Footer />
</BaseLayout>

<style>
  /* ===== HERO SECTION ===== */
  .careers-hero {
    padding: calc(80px + 7rem) 0 8rem;
    background: 
      linear-gradient(to bottom, 
        transparent 0%,
        transparent 70%,
        rgba(0, 0, 0, 0.03) 100%
      ),
      linear-gradient(135deg, 
        rgba(168, 85, 247, 0.15) 0%,
        rgba(219, 39, 119, 0.15) 50%,
        rgba(249, 115, 22, 0.12) 100%
      );
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  
  .careers-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: 
      radial-gradient(ellipse at 50% 20%, rgba(236, 72, 153, 0.12) 0%, transparent 40%),
      radial-gradient(ellipse at 50% 100%, rgba(236, 72, 153, 0.08) 0%, transparent 50%),
      radial-gradient(circle at 50% 50%, rgba(236, 72, 153, 0.15) 0%, transparent 70%),
      url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ec4899' fill-opacity='0.015'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
    pointer-events: none;
    animation: pulse 4s ease-in-out infinite;
  }
  
  @keyframes pulse {
    0%, 100% { opacity: 0.5; }
    50% { opacity: 1; }
  }
  
  .careers-hero::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, 
      transparent 0%,
      rgba(236, 72, 153, 0.3) 50%,
      transparent 100%
    );
    box-shadow: 0 4px 12px rgba(236, 72, 153, 0.15);
  }
  
  [data-theme="dark"] .careers-hero {
    background: 
      linear-gradient(to bottom, 
        transparent 0%,
        transparent 70%,
        rgba(0, 0, 0, 0.2) 100%
      ),
      linear-gradient(135deg, 
        rgba(88, 28, 135, 0.4) 0%,
        rgba(136, 19, 55, 0.4) 50%,
        rgba(154, 52, 18, 0.3) 100%
      );
  }
  
  [data-theme="dark"] .careers-hero::before {
    background: 
      radial-gradient(ellipse at 50% 20%, rgba(236, 72, 153, 0.18) 0%, transparent 40%),
      radial-gradient(ellipse at 50% 100%, rgba(236, 72, 153, 0.12) 0%, transparent 50%),
      radial-gradient(circle at 50% 50%, rgba(236, 72, 153, 0.2) 0%, transparent 70%),
      url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ec4899' fill-opacity='0.02'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
  }
  
  [data-theme="dark"] .careers-hero::after {
    background: linear-gradient(90deg, 
      transparent 0%,
      rgba(236, 72, 153, 0.4) 50%,
      transparent 100%
    );
    box-shadow: 0 4px 12px rgba(236, 72, 153, 0.2);
  }
  
  .hero-content {
    max-width: 900px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }
  
  .hero-badge {
    display: inline-block;
    padding: 0.5rem 1.25rem;
    background: linear-gradient(135deg, 
      rgba(236, 72, 153, 0.15),
      rgba(139, 92, 246, 0.15)
    );
    color: var(--color-primary-600);
    border-radius: 999px;
    font-size: 0.875rem;
    font-weight: 700;
    border: 1px solid rgba(236, 72, 153, 0.25);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin-bottom: 2rem;
    animation: fadeInUp 0.6s ease-out;
  }
  
  [data-theme="dark"] .hero-badge {
    background: linear-gradient(135deg, 
      rgba(236, 72, 153, 0.2),
      rgba(139, 92, 246, 0.2)
    );
    color: rgba(236, 72, 153, 0.95);
    border-color: rgba(236, 72, 153, 0.35);
  }
  
  .hero-title {
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    margin-bottom: 1.5rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.1;
    animation: fadeInUp 0.6s ease-out 0.1s both;
  }
  
  .hero-description {
    font-size: clamp(1rem, 2vw, 1.125rem);
    color: var(--text-secondary);
    opacity: 0.85;
    line-height: 1.7;
    margin-bottom: 3rem;
    max-width: 700px;
    margin-left: auto;
    margin-right: auto;
    animation: fadeInUp 0.6s ease-out 0.2s both;
  }
  
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  .hero-stats {
    display: flex;
    justify-content: center;
    gap: 4rem;
    flex-wrap: wrap;
    animation: fadeInUp 0.6s ease-out 0.3s both;
  }
  
  .stat-item {
    text-align: center;
  }
  
  .stat-number {
    font-size: clamp(2.5rem, 4vw, 3.5rem);
    font-weight: 800;
    background: linear-gradient(135deg, 
      var(--color-primary-500),
      var(--color-secondary-500)
    );
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    line-height: 1;
    margin-bottom: 0.5rem;
  }
  
  .stat-label {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    opacity: 0.8;
    font-weight: 500;
  }

  /* ===== BENEFITS SECTION ===== */
  .benefits-section {
    background: var(--bg-primary);
    padding: 6rem 0;
    position: relative;
  }
  
  .benefits-section::before {
    content: '';
    position: absolute;
    inset: 0;
    background: 
      radial-gradient(ellipse at 30% 50%, rgba(236, 72, 153, 0.03) 0%, transparent 50%),
      radial-gradient(ellipse at 70% 50%, rgba(139, 92, 246, 0.03) 0%, transparent 50%),
      url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ec4899' fill-opacity='0.015'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
    pointer-events: none;
  }
  
  [data-theme="dark"] .benefits-section::before {
    background: 
      radial-gradient(ellipse at 30% 50%, rgba(236, 72, 153, 0.05) 0%, transparent 50%),
      radial-gradient(ellipse at 70% 50%, rgba(139, 92, 246, 0.05) 0%, transparent 50%),
      url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ec4899' fill-opacity='0.02'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
  }
  
  .section-header {
    text-align: center;
    max-width: 800px;
    margin: 0 auto 4rem;
    position: relative;
    z-index: 1;
  }
  
  .section-title {
    font-size: clamp(2rem, 4vw, 3rem);
    margin-bottom: 1rem;
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  
  .section-subtitle {
    font-size: clamp(1rem, 2vw, 1.25rem);
    color: var(--text-secondary);
    opacity: 0.85;
    line-height: 1.6;
  }
  
  .benefits-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
    position: relative;
    z-index: 1;
  }
  
  .benefit-card {
    text-align: center;
    padding: 3rem 2rem;
    background: var(--bg-secondary);
    border-radius: var(--radius-xl);
    border: 1.5px solid rgba(236, 72, 153, 0.12);
    box-shadow: 
      var(--shadow-sm),
      0 0 20px rgba(236, 72, 153, 0.05);
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    overflow: hidden;
  }
  
  .benefit-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, 
      rgba(236, 72, 153, 0.04),
      rgba(139, 92, 246, 0.04)
    );
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  
  .benefit-card:hover {
    transform: translateY(-8px);
    box-shadow: 
      var(--shadow-lg),
      0 0 40px rgba(236, 72, 153, 0.18);
    border-color: rgba(236, 72, 153, 0.3);
  }
  
  .benefit-card:hover::before {
    opacity: 1;
  }
  
  [data-theme="dark"] .benefit-card {
    background: rgba(18, 18, 26, 0.8);
    backdrop-filter: blur(8px);
    border-color: rgba(236, 72, 153, 0.18);
    box-shadow: 
      var(--shadow-sm),
      0 0 20px rgba(236, 72, 153, 0.08);
  }
  
  [data-theme="dark"] .benefit-card:hover {
    box-shadow: 
      var(--shadow-lg),
      0 0 50px rgba(236, 72, 153, 0.25);
    border-color: rgba(236, 72, 153, 0.4);
  }
  
  .benefit-icon {
    font-size: 4rem;
    margin-bottom: 1.5rem;
    filter: drop-shadow(0 4px 12px rgba(236, 72, 153, 0.3));
    transition: all 0.3s ease;
    position: relative;
    z-index: 1;
  }
  
  .benefit-card:hover .benefit-icon {
    transform: scale(1.15) rotate(5deg);
    filter: drop-shadow(0 6px 20px rgba(236, 72, 153, 0.45));
  }
  
  .benefit-title {
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 1rem;
    color: var(--text-primary);
    position: relative;
    z-index: 1;
  }
  
  .benefit-description {
    color: var(--text-secondary);
    opacity: 0.9;
    line-height: 1.7;
    font-size: 0.9375rem;
    margin: 0;
    position: relative;
    z-index: 1;
  }

  /* ===== JOBS SECTION ===== */
  .jobs-section {
    background: var(--bg-secondary);
    padding: 6rem 0;
  }
  
  .jobs-list {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    max-width: 1000px;
    margin: 0 auto;
  }
  
  .job-card {
    padding: 2.5rem;
    background: var(--bg-primary);
    border-radius: var(--radius-xl);
    border: 1.5px solid rgba(236, 72, 153, 0.12);
