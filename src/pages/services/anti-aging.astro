---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';

const service = {
  id: 'anti-aging',
  icon: 'https://images.unsplash.com/photo-1629198688000-71f23e745b6e?w=400&h=400&fit=crop&q=95&auto=format',
  title: 'Anti-Aging Treatments',
  tagline: 'Turn Back Time with Advanced Solutions',
  description: 'Our comprehensive anti-aging treatments combine cutting-edge technology with proven techniques to reduce wrinkles, restore volume, and rejuvenate your appearance. Achieve natural-looking, youthful results.',
  price: 'From $300',
  duration: '30-90 minutes',
  category: 'Age Management'
};

const treatments = [
  {
    name: 'Botox Injections',
    description: 'FDA-approved neurotoxin to smooth wrinkles and prevent new lines from forming.',
    duration: '30 min',
    price: '$350',
    benefits: ['Smooths wrinkles', 'Prevents new lines', 'Natural results', 'No downtime'],
    image: 'https://images.unsplash.com/photo-1629198688000-71f23e745b6e?w=600&h=400&fit=crop&q=95&auto=format'
  },
  {
    name: 'Dermal Fillers',
    description: 'Hyaluronic acid fillers to restore volume, plump lips, and enhance facial contours.',
    duration: '45 min',
    price: '$600',
    benefits: ['Restores volume', 'Plumps lips', 'Lifts cheeks', 'Instant results'],
    image: 'https://images.unsplash.com/photo-1598440947619-2c35fc9aa908?w=600&h=400&fit=crop&q=95&auto=format'
  },
  {
    name: 'PRP Therapy',
    description: 'Platelet-Rich Plasma treatment to stimulate collagen and rejuvenate skin naturally.',
    duration: '60 min',
    price: '$500',
    benefits: ['Natural rejuvenation', 'Boosts collagen', 'Improves texture', 'Long-lasting'],
    image: 'https://images.unsplash.com/photo-1612349317150-e413f6a5b16d?w=600&h=400&fit=crop&q=95&auto=format'
  },
  {
    name: 'Microneedling RF',
    description: 'Radiofrequency microneedling to tighten skin, reduce wrinkles, and improve texture.',
    duration: '60 min',
    price: '$450',
    benefits: ['Tightens skin', 'Reduces wrinkles', 'Minimizes pores', 'Improves texture'],
    image: 'https://images.unsplash.com/photo-1515377905703-c4788e51af15?w=600&h=400&fit=crop&q=95&auto=format'
  },
  {
    name: 'Thread Lift',
    description: 'Non-surgical facelift using dissolvable threads to lift and tighten sagging skin.',
    duration: '90 min',
    price: '$1,200',
    benefits: ['Lifts sagging skin', 'Defines jawline', 'Minimal downtime', 'Natural lift'],
    image: 'https://images.unsplash.com/photo-1519823551278-64ac92734fb1?w=600&h=400&fit=crop&q=95&auto=format'
  },
  {
    name: 'Chemical Peel Pro',
    description: 'Professional-grade chemical peel to reduce fine lines, sun damage, and age spots.',
    duration: '45 min',
    price: '$300',
    benefits: ['Reduces fine lines', 'Fades age spots', 'Brightens skin', 'Evens tone'],
    image: 'https://images.unsplash.com/photo-1487412947147-5cebf100ffc2?w=600&h=400&fit=crop&q=95&auto=format'
  }
];

const process = [
  {
    step: 1,
    title: 'Consultation',
    description: 'Detailed facial analysis and personalized treatment plan with our anti-aging specialists.'
  },
  {
    step: 2,
    title: 'Preparation',
    description: 'Skin cleansing and marking treatment areas for precise, natural-looking results.'
  },
  {
    step: 3,
    title: 'Treatment',
    description: 'Expert application of injectables or procedures using advanced techniques for optimal results.'
  },
  {
    step: 4,
    title: 'Follow-up',
    description: 'Post-treatment care guidance and scheduling touch-ups or maintenance sessions.'
  }
];

const faqs = [
  {
    question: 'At what age should I start anti-aging treatments?',
    answer: 'Prevention is key! Many patients start in their late 20s or early 30s with preventative Botox. However, anti-aging treatments are effective at any age. We create customized plans based on your concerns and goals.'
  },
  {
    question: 'How long do results last?',
    answer: 'Results vary by treatment. Botox lasts 3-4 months, fillers 6-18 months depending on type, PRP 12-18 months, and thread lifts 1-2 years. We recommend maintenance treatments to sustain optimal results.'
  },
  {
    question: 'Will I look frozen or unnatural?',
    answer: 'Absolutely not! Our philosophy is natural enhancement. We use conservative amounts and precise techniques to maintain your facial expressions while reducing signs of aging. You\'ll look refreshed, not overdone.'
  },
  {
    question: 'Are anti-aging treatments painful?',
    answer: 'Most treatments involve minimal discomfort. We use ultra-fine needles and can apply numbing cream for sensitive patients. Most describe the sensation as a small pinch. Any discomfort is brief and well-tolerated.'
  }
];

const relatedServices = [
  { 
    id: 'facial', 
    title: 'Facial Treatments', 
    icon: 'https://images.unsplash.com/photo-1570172619644-dfd03ed5d881?w=600&h=400&fit=crop&q=95&auto=format'
  },
  { 
    id: 'laser', 
    title: 'Laser Therapy', 
    icon: 'https://images.unsplash.com/photo-1519494026892-80bbd2d6fd0d?w=600&h=400&fit=crop&q=95&auto=format'
  },
  { 
    id: 'body', 
    title: 'Body Treatments', 
    icon: 'https://images.unsplash.com/photo-1544161515-4ab6ce6db874?w=600&h=400&fit=crop&q=95&auto=format'
  }
];
---

<BaseLayout 
  title="Anti-Aging Treatments - Beauty Clinic"
  description="Advanced anti-aging treatments including Botox, dermal fillers, PRP therapy, and more. Turn back time with natural-looking results. Book your consultation today."
>
  <Header />
  
  <main>
    <!-- Hero Section -->
    <section class="service-hero">
      <div class="container">
        <div class="hero-content">
          <div class="hero-badge">{service.category}</div>
          <div class="hero-icon">
            <img src={service.icon} alt="Anti-Aging Treatment" loading="lazy" />
          </div>
          <h1 class="hero-title">{service.title}</h1>
          <p class="hero-tagline">{service.tagline}</p>
          <p class="hero-description">{service.description}</p>
          
          <div class="hero-meta">
            <div class="meta-item">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
              </svg>
              <span>{service.duration}</span>
            </div>
            <div class="meta-item">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="12" y1="1" x2="12" y2="23"></line>
                <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
              </svg>
              <span>{service.price}</span>
            </div>
          </div>
          
          <div class="hero-actions">
            <a href="/booking?service=laser" class="btn btn-primary btn-large">
              Book Appointment
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
            <a href="/contact" class="btn btn-secondary btn-large">
              Ask Questions
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Treatments Section -->
    <section class="treatments-section">
      <div class="container">
        <div class="section-header">
          <h2 class="section-title">Available Treatments</h2>
          <p class="section-subtitle">Choose the perfect anti-aging treatment for your goals</p>
        </div>
        
        <div class="treatments-grid">
          {treatments.map((treatment, index) => (
            <div class={`treatment-card card reveal stagger-${(index % 3) + 1}`}>
              <div class="treatment-image">
                <img src={treatment.image} alt={treatment.name} loading="lazy" />
              </div>
              
              <div class="treatment-header">
                <h3 class="treatment-name">{treatment.name}</h3>
                <div class="treatment-meta">
                  <span class="treatment-price">{treatment.price}</span>
                  <span class="treatment-duration">{treatment.duration}</span>
                </div>
              </div>
              
              <p class="treatment-description">{treatment.description}</p>
              
              <div class="treatment-benefits">
                <h4 class="benefits-title">Key Benefits:</h4>
                <ul class="benefits-list">
                  {treatment.benefits.map(benefit => (
                    <li class="benefit-item">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="20 6 9 17 4 12"></polyline>
                      </svg>
                      {benefit}
                    </li>
                  ))}
                </ul>
              </div>
              
              <a href={`/booking?service=anti-aging&treatment=${treatment.name.toLowerCase().replace(/\s+/g, '-')}`} class="btn btn-outline">
                Select Treatment
              </a>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Process Section -->
    <section class="process-section">
      <div class="container">
        <div class="section-header">
          <h2 class="section-title">Treatment Process</h2>
          <p class="section-subtitle">What to expect during your laser treatment</p>
        </div>
        
        <div class="process-timeline">
          {process.map((item, index) => (
            <div class={`process-step reveal stagger-${index + 1}`}>
              <div class="step-number">{item.step}</div>
              <div class="step-content">
                <h3 class="step-title">{item.title}</h3>
                <p class="step-description">{item.description}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="faq-section">
      <div class="container">
        <div class="section-header">
          <h2 class="section-title">Frequently Asked Questions</h2>
          <p class="section-subtitle">Everything you need to know about laser treatments</p>
        </div>
        
        <div class="faq-grid">
          {faqs.map((faq, index) => (
            <div class={`faq-item card reveal stagger-${(index % 2) + 1}`}>
              <h3 class="faq-question">{faq.question}</h3>
              <p class="faq-answer">{faq.answer}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Related Services -->
    <section class="related-section">
      <div class="container">
        <div class="section-header">
          <h2 class="section-title">Related Services</h2>
          <p class="section-subtitle">Explore other treatments that complement laser therapy</p>
        </div>
        
        <div class="related-grid">
          {relatedServices.map((related, index) => (
            <a href={`/services/${related.id}`} class={`related-card card reveal stagger-${index + 1}`}>
              <div class="related-icon">
                <img src={related.icon} alt={related.title} loading="lazy" />
              </div>
              <h3 class="related-title">{related.title}</h3>
              <svg class="related-arrow" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="cta-section">
      <div class="container">
        <div class="cta-content">
          <h2 class="cta-title">Ready to Experience Advanced Laser Technology?</h2>
          <p class="cta-text">
            Book your laser consultation today and discover safe, effective solutions for your skin concerns.
          </p>
          <a href="/booking?service=laser" class="btn btn-secondary btn-large">
            Book Your Consultation Now
          </a>
        </div>
      </div>
    </section>
  </main>
  
  <Footer />
</BaseLayout>

<style>
  /* ===== HERO SECTION - ENHANCED LAYERING ===== */
  .service-hero {
    padding: calc(80px + 7rem) 0 8rem;
    background: 
      linear-gradient(to bottom, 
        transparent 0%,
        transparent 70%,
        rgba(0, 0, 0, 0.03) 100%
      ),
      linear-gradient(135deg, 
        rgba(168, 85, 247, 0.15) 0%,
        rgba(219, 39, 119, 0.15) 50%,
        rgba(249, 115, 22, 0.12) 100%
      );
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  
  /* Enhanced radial glow with noise texture */
  .service-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: 
      radial-gradient(ellipse at 50% 20%, rgba(236, 72, 153, 0.12) 0%, transparent 40%),
      radial-gradient(ellipse at 50% 100%, rgba(236, 72, 153, 0.08) 0%, transparent 50%),
      radial-gradient(circle at 50% 50%, rgba(236, 72, 153, 0.15) 0%, transparent 70%),
      url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ec4899' fill-opacity='0.015'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
    pointer-events: none;
    animation: pulse 4s ease-in-out infinite;
  }
  
  @keyframes pulse {
    0%, 100% { opacity: 0.5; }
    50% { opacity: 1; }
  }
  
  .service-hero::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, 
      transparent 0%,
      rgba(236, 72, 153, 0.3) 50%,
      transparent 100%
    );
    box-shadow: 0 4px 12px rgba(236, 72, 153, 0.15);
  }
  
  [data-theme="dark"] .service-hero {
    background: 
      linear-gradient(to bottom, 
        transparent 0%,
        transparent 70%,
        rgba(0, 0, 0, 0.2) 100%
      ),
      linear-gradient(135deg, 
        rgba(88, 28, 135, 0.4) 0%,
        rgba(136, 19, 55, 0.4) 50%,
        rgba(154, 52, 18, 0.3) 100%
      );
  }
  
  [data-theme="dark"] .service-hero::before {
    background: 
      radial-gradient(ellipse at 50% 20%, rgba(236, 72, 153, 0.18) 0%, transparent 40%),
      radial-gradient(ellipse at 50% 100%, rgba(236, 72, 153, 0.12) 0%, transparent 50%),
      radial-gradient(circle at 50% 50%, rgba(236, 72, 153, 0.2) 0%, transparent 70%),
      url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ec4899' fill-opacity='0.02'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
  }
  
  [data-theme="dark"] .service-hero::after {
    background: linear-gradient(90deg, 
      transparent 0%,
      rgba(236, 72, 153, 0.4) 50%,
      transparent 100%
    );
    box-shadow: 0 4px 12px rgba(236, 72, 153, 0.2);
  }
  
  .hero-content {
    max-width: 900px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }
  
  .hero-badge {
    display: inline-block;
    padding: 0.5rem 1.25rem;
    background: linear-gradient(135deg, 
      rgba(236, 72, 153, 0.15),
      rgba(139, 92, 246, 0.15)
    );
    color: var(--color-primary-600);
    border-radius: 999px;
    font-size: 0.875rem;
    font-weight: 700;
    border: 1px solid rgba(236, 72, 153, 0.25);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin-bottom: 2rem;
    animation: fadeInUp 0.6s ease-out;
  }
  
  [data-theme="dark"] .hero-badge {
    background: linear-gradient(135deg, 
      rgba(236, 72, 153, 0.2),
      rgba(139, 92, 246, 0.2)
    );
    color: rgba(236, 72, 153, 0.95);
    border-color: rgba(236, 72, 153, 0.35);
  }
  
  .hero-icon {
    width: 120px;
    height: 120px;
    margin: 0 auto 1.5rem;
    border-radius: var(--radius-full);
    overflow: hidden;
    box-shadow: 
      0 8px 24px rgba(236, 72, 153, 0.3),
      0 0 40px rgba(236, 72, 153, 0.2);
    animation: fadeInUp 0.6s ease-out 0.1s both;
    position: relative;
  }
  
  .hero-icon::before {
    content: '';
    position: absolute;
    inset: -4px;
    border-radius: var(--radius-full);
    background: linear-gradient(135deg, 
      rgba(236, 72, 153, 0.4),
      rgba(139, 92, 246, 0.4)
    );
    z-index: -1;
    animation: pulseGlow 3s ease-in-out infinite;
  }
  
  .hero-icon img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  
  .hero-title {
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    margin-bottom: 1.5rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.1;
    animation: fadeInUp 0.6s ease-out 0.2s both;
  }
  
  .hero-tagline {
    font-size: clamp(1.25rem, 2.5vw, 1.75rem);
    color: var(--text-primary);
    opacity: 0.9;
    margin-bottom: 1.5rem;
    font-weight: 600;
    animation: fadeInUp 0.6s ease-out 0.3s both;
  }
  
  .hero-description {
    font-size: clamp(1rem, 2vw, 1.125rem);
    color: var(--text-secondary);
    opacity: 0.85;
    line-height: 1.7;
    margin-bottom: 2.5rem;
    max-width: 700px;
    margin-left: auto;
    margin-right: auto;
    animation: fadeInUp 0.6s ease-out 0.4s both;
  }
  
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  .hero-meta {
    display: flex;
    justify-content: center;
    gap: 3rem;
    margin-bottom: 3rem;
    animation: fadeInUp 0.6s ease-out 0.5s both;
  }
  
  .meta-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 1.5rem;
    background: linear-gradient(135deg, 
      rgba(236, 72, 153, 0.08),
      rgba(139, 92, 246, 0.08)
    );
    border-radius: var(--radius-xl);
    border: 1.5px solid rgba(236, 72, 153, 0.15);
    box-shadow: 0 2px 8px rgba(236, 72, 153, 0.08);
  }
  
  [data-theme="dark"] .meta-item {
    background: linear-gradient(135deg, 
      rgba(236, 72, 153, 0.12),
      rgba(139, 92, 246, 0.12)
    );
    border-color: rgba(236, 72, 153, 0.25);
  }
  
  .meta-item svg {
    color: var(--color-primary-500);
    flex-shrink: 0;
  }
  
  .meta-item span {
    font-weight: 600;
    font-size: 1.0625rem;
    color: var(--text-primary);
  }
  
  .hero-actions {
    display: flex;
    justify-content: center;
    gap: 1.5rem;
    flex-wrap: wrap;
    animation: fadeInUp 0.6s ease-out 0.6s both;
  }
  
  .btn-large {
    padding: 1.125rem 2.5rem;
    font-size: 1.0625rem;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    border-radius: var(--radius-lg);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    overflow: hidden;
  }
  
  .btn-primary {
    background: linear-gradient(135deg, 
      rgba(236, 72, 153, 0.95),
      rgba(219, 39, 119, 0.95)
    );
    border: none;
    color: white;
    box-shadow: 
      0 4px 16px rgba(236, 72, 153, 0.4),
      0 0 30px rgba(236, 72, 153, 0.25);
  }
  
  .btn-primary::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, 
      rgba(255, 255, 255, 0.15),
      transparent
    );
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  
  .btn-primary:hover {
    transform: translateY(-4px);
    box-shadow: 
      0 6px 24px rgba(236, 72, 153, 0.5),
      0 0 40px rgba(236, 72, 153, 0.35);
  }
  
  .btn-primary:hover::before {
    opacity: 1;
  }
  
  .btn-primary:active {
    transform: translateY(-2px);
  }
  
  .btn-primary svg {
    transition: transform 0.3s ease;
  }
  
  .btn-primary:hover svg {
    transform: translateX(4px);
  }
  
  .btn-secondary {
    background: var(--bg-secondary);
    border: 2px solid rgba(236, 72, 153, 0.25);
    color: var(--text-primary);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    position: relative;
  }
  
  .btn-secondary::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, 
      rgba(236, 72, 153, 0.06),
      rgba(139, 92, 246, 0.06)
    );
    opacity: 0;
    transition: opacity 0.3s ease;
    border-radius: var(--radius-lg);
  }
  
  .btn-secondary:hover {
    transform: translateY(-4px);
    border-color: rgba(236, 72, 153, 0.5);
    box-shadow: 0 6px 20px rgba(236, 72, 153, 0.25);
  }
  
  .btn-secondary:hover::before {
    opacity: 1;
  }
  
  .btn-secondary:active {
    transform: translateY(-2px);
  }
  
  [data-theme="dark"] .btn-secondary {
    background: rgba(18, 18, 26, 0.8);
    backdrop-filter: blur(8px);
    border-color: rgba(236, 72, 153, 0.35);
  }
  
  [data-theme="dark"] .btn-secondary:hover {
    border-color: rgba(236, 72, 153, 0.6);
    box-shadow: 0 6px 20px rgba(236, 72, 153, 0.35);
  }

  /* ===== TREATMENTS SECTION ===== */
  .treatments-section {
    background: var(--bg-primary);
    padding: 6rem 0;
    position: relative;
  }
  
  .treatments-section::before {
    content: '';
    position: absolute;
    inset: 0;
    background: 
      radial-gradient(ellipse at 30% 50%, rgba(236, 72, 153, 0.03) 0%, transparent 50%),
      radial-gradient(ellipse at 70% 50%, rgba(139, 92, 246, 0.03) 0%, transparent 50%),
      url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ec4899' fill-opacity='0.015'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
    pointer-events: none;
  }
  
  [data-theme="dark"] .treatments-section::before {
    background: 
      radial-gradient(ellipse at 30% 50%, rgba(236, 72, 153, 0.05) 0%, transparent 50%),
      radial-gradient(ellipse at 70% 50%, rgba(139, 92, 246, 0.05) 0%, transparent 50%),
      url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ec4899' fill-opacity='0.02'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
  }
  
  .section-header {
    text-align: center;
    max-width: 800px;
    margin: 0 auto 4rem;
    position: relative;
    z-index: 1;
  }
  
  .section-title {
    font-size: clamp(2rem, 4vw, 3rem);
    margin-bottom: 1rem;
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  
  .section-subtitle {
    font-size: clamp(1rem, 2vw, 1.25rem);
    color: var(--text-secondary);
    opacity: 0.85;
    line-height: 1.6;
  }
  
  .treatments-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
    gap: 2rem;
    position: relative;
    z-index: 1;
  }
  
  .treatment-card {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding: 0;
    background: var(--bg-secondary);
    border-radius: var(--radius-xl);
    border: 1.5px solid rgba(236, 72, 153, 0.12);
    box-shadow: 
      var(--shadow-sm),
      0 0 20px rgba(236, 72, 153, 0.05);
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    overflow: hidden;
  }
  
  .treatment-image {
    width: 100%;
    height: 240px;
    overflow: hidden;
    position: relative;
  }
  
  .treatment-image::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, 
      transparent 0%,
      rgba(0, 0, 0, 0.05) 100%
    );
    z-index: 1;
    transition: opacity 0.3s ease;
  }
  
  .treatment-card:hover .treatment-image::before {
    opacity: 0;
  }
  
  .treatment-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }
  
  .treatment-card:hover .treatment-image img {
    transform: scale(1.08);
  }
  
  .treatment-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, 
      rgba(236, 72, 153, 0.04),
      rgba(139, 92, 246, 0.04)
    );
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  
  .treatment-card:hover {
    transform: translateY(-8px);
    box-shadow: 
      var(--shadow-lg),
      0 0 40px rgba(236, 72, 153, 0.18);
    border-color: rgba(236, 72, 153, 0.3);
  }
  
  .treatment-card:hover::before {
    opacity: 1;
  }
  
  [data-theme="dark"] .treatment-card {
    background: rgba(18, 18, 26, 0.8);
    backdrop-filter: blur(8px);
    border-color: rgba(236, 72, 153, 0.18);
    box-shadow: 
      var(--shadow-sm),
      0 0 20px rgba(236, 72, 153, 0.08);
  }
  
  [data-theme="dark"] .treatment-card:hover {
    box-shadow: 
      var(--shadow-lg),
      0 0 50px rgba(236, 72, 153, 0.25);
    border-color: rgba(236, 72, 153, 0.4);
  }
  
  .treatment-header {
    display: flex;
    justify-content: space-between;
    align-items: start;
    gap: 1rem;
    position: relative;
    z-index: 1;
    padding: 1.5rem 2.5rem 0;
  }
  
  .treatment-name {
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.3;
    flex: 1;
  }
  
  .treatment-meta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.25rem;
    background: linear-gradient(135deg, 
      rgba(236, 72, 153, 0.12),
      rgba(139, 92, 246, 0.12)
    );
    padding: 0.75rem 1rem;
    border-radius: 999px;
    border: 1px solid rgba(236, 72, 153, 0.25);
    flex-shrink: 0;
    box-shadow: 
      0 2px 8px rgba(236, 72, 153, 0.15),
      0 0 20px rgba(236, 72, 153, 0.08);
    position: relative;
  }
  
  .treatment-meta::before {
    content: '';
    position: absolute;
    inset: -3px;
    border-radius: 999px;
    background: radial-gradient(circle, rgba(236, 72, 153, 0.15), transparent 70%);
    z-index: -1;
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  
  .treatment-card:hover .treatment-meta::before {
    opacity: 1;
  }
  
  [data-theme="dark"] .treatment-meta {
    background: linear-gradient(135deg, 
      rgba(236, 72, 153, 0.18),
      rgba(139, 92, 246, 0.18)
    );
    border-color: rgba(236, 72, 153, 0.35);
    box-shadow: 
      0 2px 8px rgba(236, 72, 153, 0.2),
      0 0 25px rgba(236, 72, 153, 0.12);
  }
  
  .treatment-price {
    font-weight: 700;
    color: var(--color-primary-600);
    font-size: 1.125rem;
    line-height: 1;
  }
  
  [data-theme="dark"] .treatment-price {
    color: rgba(236, 72, 153, 0.95);
  }
  
  .treatment-duration {
    font-size: 0.8125rem;
    color: var(--text-secondary);
    opacity: 0.8;
    font-weight: 500;
    line-height: 1;
  }
  
  .treatment-description {
    color: var(--text-secondary);
    opacity: 0.9;
    line-height: 1.7;
    font-size: 0.9375rem;
    position: relative;
    z-index: 1;
    padding: 0 2.5rem;
  }
  
  .treatment-benefits {
    flex: 1;
    position: relative;
    z-index: 1;
    padding: 0 2.5rem;
  }
  
  .benefits-title {
    font-size: 0.9375rem;
    font-weight: 600;
    margin-bottom: 1rem;
    color: var(--text-primary);
  }
  
  .benefits-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }
  
  .benefit-item {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    color: var(--text-secondary);
    opacity: 0.9;
    font-size: 0.875rem;
    line-height: 1.6;
    transition: all 0.3s ease;
  }
  
  .treatment-card:hover .benefit-item {
    opacity: 1;
  }
  
  .benefit-item svg {
    color: var(--color-primary-500);
    flex-shrink: 0;
    filter: drop-shadow(0 2px 4px rgba(236, 72, 153, 0.3));
  }
  
  [data-theme="dark"] .benefit-item svg {
    color: rgba(236, 72, 153, 0.9);
    filter: drop-shadow(0 2px 6px rgba(236, 72, 153, 0.4));
  }
  
  .btn-outline {
    width: calc(100% - 5rem);
    margin: 0 2.5rem 2.5rem;
    padding: 1rem 2rem;
    font-size: 1rem;
    font-weight: 600;
    border: 2px solid rgba(236, 72, 153, 0.25);
    background: transparent;
    color: var(--text-primary);
    border-radius: var(--radius-lg);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    z-index: 1;
    overflow: hidden;
  }
  
  .btn-outline::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, 
      rgba(236, 72, 153, 0.1),
      rgba(139, 92, 246, 0.1)
    );
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  
  .btn-outline::after {
    content: '→';
    position: absolute;
    right: 2rem;
    top: 50%;
    transform: translateY(-50%) translateX(0);
    opacity: 0;
    transition: all 0.3s ease;
    font-size: 1.25rem;
    color: var(--color-primary-500);
  }
  
  .btn-outline:hover {
    border-color: rgba(236, 72, 153, 0.6);
    transform: translateY(-3px);
    box-shadow: 0 6px 16px rgba(236, 72, 153, 0.25);
    padding-right: 3rem;
  }
  
  .btn-outline:hover::before {
    opacity: 1;
  }
  
  .btn-outline:hover::after {
    opacity: 1;
    transform: translateY(-50%) translateX(4px);
  }
  
  [data-theme="dark"] .btn-outline {
    border-color: rgba(236, 72, 153, 0.35);
  }
  
  [data-theme="dark"] .btn-outline:hover {
    border-color: rgba(236, 72, 153, 0.7);
    box-shadow: 0 6px 16px rgba(236, 72, 153, 0.35);
  }
  
  [data-theme="dark"] .btn-outline::after {
    color: rgba(236, 72, 153, 0.9);
  }

  /* ===== PROCESS SECTION - ENHANCED WITH DECORATIVE ELEMENTS ===== */
  .process-section {
    background: var(--bg-secondary);
    padding: 6rem 0;
    position: relative;
    overflow: hidden;
  }
  
  /* Decorative gradient accent on right side */
  .process-section::before {
    content: '';
    position: absolute;
    right: 0;
    top: 20%;
    width: 400px;
    height: 60%;
    background: radial-gradient(ellipse at center, 
      rgba(236, 72, 153, 0.08) 0%,
      rgba(139, 92, 246, 0.06) 30%,
      transparent 70%
    );
    pointer-events: none;
    z-index: 0;
  }
  
  [data-theme="dark"] .process-section::before {
    background: radial-gradient(ellipse at center, 
      rgba(236, 72, 153, 0.12) 0%,
      rgba(139, 92, 246, 0.08) 30%,
      transparent 70%
    );
  }
  
  .process-timeline {
    max-width: 900px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 3rem;
    position: relative;
    z-index: 1;
  }
  
  /* Enhanced vertical connecting line with gradient */
  .process-timeline::before {
    content: '';
    position: absolute;
    left: 31px;
    top: 64px;
    bottom: 64px;
    width: 2px;
    background: linear-gradient(to bottom,
      rgba(236, 72, 153, 0.3),
      rgba(236, 72, 153, 0.15),
      rgba(236, 72, 153, 0.3)
    );
    box-shadow: 0 0 10px rgba(236, 72, 153, 0.2);
    z-index: 0;
  }
  
  .process-step {
    display: flex;
    gap: 2rem;
    position: relative;
    z-index: 1;
    transition: transform 0.3s ease;
  }
  
  .process-step:hover {
    transform: translateX(8px);
  }
  
  .step-number {
    width: 64px;
    height: 64px;
    border-radius: var(--radius-full);
    background: linear-gradient(135deg, rgba(236, 72, 153, 0.95), rgba(219, 39, 119, 0.95));
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 1.5rem;
    flex-shrink: 0;
    box-shadow: 
      0 4px 12px rgba(236, 72, 153, 0.35), 
      0 0 25px rgba(236, 72, 153, 0.25);
    position: relative;
    transition: all 0.3s ease;
  }
  
  /* Enhanced halo glow */
  .step-number::before {
    content: '';
    position: absolute;
    inset: -8px;
    border-radius: var(--radius-full);
    background: radial-gradient(circle, rgba(236, 72, 153, 0.4), transparent 70%);
    z-index: -1;
    animation: pulseGlow 3s ease-in-out infinite;
  }
  
  @keyframes pulseGlow {
    0%, 100% { opacity: 0.5; transform: scale(1); }
    50% { opacity: 1; transform: scale(1.1); }
  }
  
  .process-step:hover .step-number {
    transform: scale(1.08);
    box-shadow: 
      0 6px 16px rgba(236, 72, 153, 0.45), 
      0 0 35px rgba(236, 72, 153, 0.35);
  }
  
  [data-theme="dark"] .step-number {
    box-shadow: 
      0 4px 12px rgba(236, 72, 153, 0.45), 
      0 0 30px rgba(236, 72, 153, 0.35);
  }
  
  [data-theme="dark"] .process-step:hover .step-number {
    box-shadow: 
      0 6px 16px rgba(236, 72, 153, 0.55), 
      0 0 40px rgba(236, 72, 153, 0.45);
  }
  
  .step-content {
    flex: 1;
    padding: 1rem 0;
  }
  
  .step-title {
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 0.75rem;
    letter-spacing: -0.01em;
    transition: color 0.3s ease;
  }
  
  .process-step:hover .step-title {
    color: var(--color-primary-600);
  }
  
  [data-theme="dark"] .process-step:hover .step-title {
    color: rgba(236, 72, 153, 0.95);
  }
  
  .step-description {
    color: var(--text-secondary);
    opacity: 0.9;
    line-height: 1.7;
    font-size: 1rem;
  }
  
  /* ===== FAQ SECTION - ENHANCED INTERACTIVITY ===== */
  .faq-section {
    background: var(--bg-primary);
    padding: 6rem 0;
  }
  
  .faq-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(450px, 1fr));
    gap: 2rem;
  }
  
  .faq-item {
    padding: 2.5rem;
    background: var(--bg-secondary);
    border-radius: var(--radius-xl);
    border: 1.5px solid rgba(236, 72, 153, 0.12);
    box-shadow: 
      var(--shadow-sm),
      0 0 20px rgba(236, 72, 153, 0.05);
    transition: all 0.3s ease;
    position: relative;
  }
  
  /* Plus icon indicator */
  .faq-item::before {
    content: '+';
    position: absolute;
    top: 2.5rem;
    right: 2.5rem;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-primary-500);
    background: linear-gradient(135deg, 
      rgba(236, 72, 153, 0.1),
      rgba(139, 92, 246, 0.1)
    );
    border-radius: var(--radius-full);
    border: 1px solid rgba(236, 72, 153, 0.2);
    transition: all 0.3s ease;
  }
  
  .faq-item:hover {
    transform: translateY(-4px);
    box-shadow: 
      var(--shadow-md),
      0 0 35px rgba(236, 72, 153, 0.12);
    border-color: rgba(236, 72, 153, 0.25);
  }
  
  .faq-item:hover::before {
    transform: rotate(90deg);
    background: linear-gradient(135deg, 
      rgba(236, 72, 153, 0.15),
      rgba(139, 92, 246, 0.15)
    );
    border-color: rgba(236, 72, 153, 0.3);
    box-shadow: 0 0 15px rgba(236, 72, 153, 0.2);
  }
  
  [data-theme="dark"] .faq-item {
    background: rgba(18, 18, 26, 0.8);
    backdrop-filter: blur(8px);
    border-color: rgba(236, 72, 153, 0.18);
  }
  
  [data-theme="dark"] .faq-item::before {
    color: rgba(236, 72, 153, 0.9);
    background: linear-gradient(135deg, 
      rgba(236, 72, 153, 0.15),
      rgba(139, 92, 246, 0.15)
    );
    border-color: rgba(236, 72, 153, 0.3);
  }
  
  [data-theme="dark"] .faq-item:hover {
    box-shadow: 
      var(--shadow-md),
      0 0 40px rgba(236, 72, 153, 0.18);
    border-color: rgba(236, 72, 153, 0.35);
  }
  
  [data-theme="dark"] .faq-item:hover::before {
    background: linear-gradient(135deg, 
      rgba(236, 72, 153, 0.2),
      rgba(139, 92, 246, 0.2)
    );
    border-color: rgba(236, 72, 153, 0.4);
    box-shadow: 0 0 20px rgba(236, 72, 153, 0.3);
  }
  
  .faq-question {
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 1.25rem;
    color: var(--text-primary);
    line-height: 1.4;
    padding-right: 3rem;
  }
  
  .faq-answer {
    color: var(--text-secondary);
    opacity: 0.9;
    line-height: 1.8;
    font-size: 0.9375rem;
    margin: 0;
  }
  
  /* ===== RELATED SERVICES - ENHANCED ===== */
  .related-section {
    background: var(--bg-secondary);
    padding: 6rem 0;
  }
  
  .related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
  }
  
  .related-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    padding: 3rem 2rem;
    background: var(--bg-primary);
    border-radius: var(--radius-xl);
    border: 1.5px solid rgba(236, 72, 153, 0.12);
    box-shadow: 
      var(--shadow-sm),
      0 0 20px rgba(236, 72, 153, 0.05);
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    text-decoration: none;
    position: relative;
    overflow: hidden;
  }
  
  .related-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, 
      rgba(236, 72, 153, 0.06),
      rgba(139, 92, 246, 0.06)
    );
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  
  /* Glow border effect */
  .related-card::after {
    content: '';
    position: absolute;
    inset: -1px;
    border-radius: var(--radius-xl);
    padding: 1.5px;
    background: linear-gradient(135deg, 
      rgba(236, 72, 153, 0.3),
      rgba(139, 92, 246, 0.3)
    );
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  
  .related-card:hover {
    transform: translateY(-10px);
    box-shadow: 
      var(--shadow-lg),
      0 0 50px rgba(236, 72, 153, 0.2);
    border-color: rgba(236, 72, 153, 0.35);
  }
  
  .related-card:hover::before {
    opacity: 1;
  }
  
  .related-card:hover::after {
    opacity: 1;
  }
  
  [data-theme="dark"] .related-card {
    background: rgba(18, 18, 26, 0.8);
    backdrop-filter: blur(8px);
    border-color: rgba(236, 72, 153, 0.18);
  }
  
  [data-theme="dark"] .related-card:hover {
    box-shadow: 
      var(--shadow-lg),
      0 0 60px rgba(236, 72, 153, 0.25);
    border-color: rgba(236, 72, 153, 0.45);
  }
  
  .related-icon {
    width: 100%;
    height: 200px;
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: all 0.3s ease;
    position: relative;
    z-index: 1;
    box-shadow: 0 4px 12px rgba(236, 72, 153, 0.15);
  }
  
  .related-icon img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }
  
  .related-card:hover .related-icon {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(236, 72, 153, 0.25);
  }
  
  .related-card:hover .related-icon img {
    transform: scale(1.1);
  }
  
  .related-title {
    font-size: 1.25rem;
    font-weight: 700;
    text-align: center;
    color: var(--text-primary);
    position: relative;
    z-index: 1;
    transition: color 0.3s ease;
  }
  
  .related-card:hover .related-title {
    color: var(--color-primary-600);
  }
  
  [data-theme="dark"] .related-card:hover .related-title {
    color: rgba(236, 72, 153, 0.95);
  }
  
  .related-arrow {
    color: var(--color-primary-500);
    transition: all 0.3s ease;
    position: relative;
    z-index: 1;
  }
  
  .related-card:hover .related-arrow {
    transform: translateX(8px);
    filter: drop-shadow(0 2px 8px rgba(236, 72, 153, 0.4));
  }
  
  [data-theme="dark"] .related-arrow {
    color: rgba(236, 72, 153, 0.8);
  }
  
  /* ===== CTA SECTION - ENHANCED GLOW ===== */
  .cta-section {
    background: linear-gradient(135deg, 
      rgba(168, 85, 247, 0.90) 0%,
      rgba(219, 39, 119, 0.90) 50%,
      rgba(249, 115, 22, 0.86) 100%
    );
    color: white;
    padding: 6rem 0;
    position: relative;
    overflow: hidden;
  }
  
  .cta-section::before {
    content: '';
    position: absolute;
    inset: 0;
    background: 
      radial-gradient(circle at 50% 30%, rgba(255, 255, 255, 0.04) 0%, transparent 50%),
      radial-gradient(circle at 20% 70%, rgba(0, 0, 0, 0.1) 0%, transparent 40%),
      linear-gradient(135deg, rgba(0, 0, 0, 0.28) 0%, rgba(0, 0, 0, 0.18) 100%);
    z-index: 0;
  }
  
  .cta-content {
    text-align: center;
    max-width: 800px;
    margin: 0 auto;
    position: relative;
    z-index: 2;
