---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import '@/styles/booking.css';
import '@/styles/homepage.css';
import '@/styles/global.css';
import Certifications from '@/components/Certifications.astro';
import MeetGya from '@/components/MeetGya.astro';
import ConsultationSteps from '@/components/ConsultationSteps.astro';
import BeforeAndAfter from '@/components/BeforeAndAfter.astro';
import Testimonials from '@/components/Testimonials.astro';
import Faqs from '@/components/Faqs.astro';
import AboutGya from '@/components/AboutGya.astro';

// Blog posts data with realistic images
const landingPageData = {
  'skincare-routine-glowing-skin': {
    title: 'Facial Balancing Treatment',
    titleSecondRow: 'So you can put your best foot forward',
    excerpt: 'Whether that’s at work, in relationships, or when you look in the mirror.',
    treatment: 'Facial Balancing Treatment',
    location: 'Nottinghashire',
    category: 'Transformation',
    author: 'Gya',
    authorRole: 'Medical Director',
    date: '2026-02-28',
    readingTime: '8 min read',
    tags: ['skincare', 'routine', 'beginner'],
    cover: '/images/landingPages/transformation.png'
  }
};

// Generate static paths for all blog posts
export function getStaticPaths() {
  // Define blog posts data inside getStaticPaths to ensure it's available during build
  const posts = {
    'skincare-routine-glowing-skin': {
      title: 'Facial Balancing Treatment',
      titleSecondRow: 'So you can put your best foot forward',
      excerpt: 'Whether that’s at work, in relationships, or when you look in the mirror.',
      treatment: 'Facial Balancing Treatment',
      location: 'Nottinghashire',
      category: 'Transformation',
      author: 'Gya',
      authorRole: 'Medical Director',
      date: '2026-02-28',
      readingTime: '8 min read',
      tags: ['skincare', 'rejuvenation', 'lines', 'wrinkles'],
      cover: '/images/landingPages/transformation.png'
    }
  };


  
  
  return Object.keys(posts).map(slug => ({
    params: { slug }
  }));
}

const { slug } = Astro.params;
const page = landingPageData[slug as keyof typeof landingPageData];

// Get related posts (exclude current article)
const allSlugs = Object.keys(landingPageData).filter(s => s !== slug);
const relatedSlugs = allSlugs.slice(0, 3);
const relatedPosts = relatedSlugs.map(relatedSlug => {
  const post = landingPageData[relatedSlug as keyof typeof landingPageData];
  return {
    slug: relatedSlug,
    title: post.title,
    category: post.category,
    date: post.date,
    cover: post.cover
  };
});
