---
const beforeAndAfterCard = [
    {title: 'Foundation',
     image: '../images/before-after/glow-profile-balance.png',
     video: false,
     imageTitle: '',
     description: 'Rebuilded the skin’s natural layer so the face supports the expressions. (lies around the nose and the mouth), cheeks, chin', 
     treatments: ['Forehead lines', 'Smile lines', 'Nasolabil Folds', 'Marionette Lines','Hydration', 'Skin Glow']
    },
    {title: "Smoker's Lines",
     image: '../images/before-after/smoker-lines.png',
     video: false,
     imageTitle: 'Smoker Lines',
     description: 'Fine vertical lines around the lips smoothed out using a micro technique. Lips preserved their natural shape, movement and expression.',
     treatments: ['Fine lines', "Smoker's Lines", 'Hydration']
    },
    {title: 'Expressions Preserved',
     image: '../images/before-after/after-transformation.png',
     video: false,
     imageTitle: 'After 2 Days',
     description: 'The filler has integrated naturally with the anatomy. She is laughing and speaking without any stiffness.',
     treatments: ['Skin Glow', 'Profile Balance', 'Hydration', 'Skin Foundation']
    }, 
    {title:'Amaizing Transformation', 
     image: '../videos/TreansformationSection.mp4',
     video: true,
     imageTitle: 'Transformation',
     description: 'The filler has integrated naturally with the anatomy. She is laughing and speaking without any stiffness.',
     treatments: ['Skin Glow', 'Profile Balance', 'Hydration', 'Skin Foundation']
    }
];
type Props = { decor: String; decorClass: String}

const {decor, decorClass} = Astro.props;
---
  <style>
    @import '../styles/homepage.css';
  </style>
  
<section class="before-and-after-section">
    <div class="container before-and-after-container">
        <div class="section-header reveal">
            <h2 class="featured-post card section-title {decorClass}">{decor}</h2>
            <!-- <p class="section-subtitle">While helping deeper lines become less noticeable. <br />-->
            <!--<p class="section-subtitle">Deeper lines less noticeable <br />
            No frozen expressions <br /> -->
            <!-- See how results settle naturally over time. -->

            
             <h2 class="section-title before-and-after-padding">One transformation</h2>
             <p class="section-subtitle">Tailored combination of precisely placed dermal fillers. <br />
             A foundation that settles naturally. </p>
          </p>
        </div>

        <div class="before-and-after-grid">
            
                {beforeAndAfterCard.map(card => (
                    <article class="featured-post card before-and-after-card">
                    {card.video && (
                        <div class="video-client-gya">
                            <video class="before-and-after-grid-video" width="300" height="400" muted="" loop="" autoplay=""  id="video" class="video-in-viewport w-full h-full object-cover "> 
                            <source src={card.image}type="video/mp4">Sorry, your browser doesn't support embedded videos.
                            </video>
                        </div>
                    )}
                
                    {!card.video && ( 
                        <img 
                        src={card.image} 
                        alt={card.imageTitle}
                        class="featured-cover-image"
                        loading="eager"
                    />
                    )}
                    
                    <span class="before-and-after-card-title price-value">{card.title}</span>
                    <p class="before-and-after-description">{card.description}</p>
                    <div class="service-features">
                         {card.treatments.map(feature => (
                  <span class="feature-tag">{feature}</span>
                ))}
                    </div>
                  </article>
                ))}
            
            

        </div>
        
    
    </div>
</section>

<style>
    .card{
             background: radial-gradient(circle at 20% 30%, rgba(236, 72, 153, 0.08) 0%, transparent 50%), radial-gradient(circle at 80% 70%, rgba(139, 92, 246, 0.08) 0%, transparent 50%), radial-gradient(circle at 50% 50%, rgba(249, 115, 22, 0.05) 0%, transparent 50%);
    
    }
    .section-title{
        font-size: 2.2rem;
            color: var(--text-secondary);
    }
    .section-header{
        margin-bottom: 1rem;
    }
    .before-and-after-section{
        padding-top: 3rem;
    }
    .before-and-after-container{
        max-width: 1600px;
    }
    .before-and-after-grid{
        display: grid;
        grid-template-columns: 0.25fr 0.25fr 0.25fr 0.25fr;
        gap:1rem;
    }
    .before-and-after-card{
        padding: 1rem;
    }
    .before-and-after-card-title {
        padding: 2rem 0rem;
        font-size: 1.7rem;
        font-weight: 800;
        margin: 0;
    }
    .before-and-after-padding{
        padding-top: 4rem;
    }
    .before-and-after-grid-video{
        max-width: 100%;
        height: auto;
        display: block;
    }
    

    /* Mobile */
    @media (max-width: 768px) {
        .before-and-after-grid {
            grid-template-columns: 1fr;
        }
        .before-and-after-title{
             font-size: 1.15rem;
        }
    }
</style>