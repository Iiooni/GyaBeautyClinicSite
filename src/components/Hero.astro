          <div class="metric-value">
            <span class="counter" data-target="250">0</span>+
          </div>
          <div class="metric-label">Clients</div>
        </div>
        <div class="metric-separator"></div>
        <div class="metric">
          <div class="metric-value">
            <span class="counter" data-target="98">0</span>%
          </div>
          <div class="metric-label">Satisfaction</div>
        </div>
      </div>
    </div>
    
    <div class="hero-visual reveal-right">
      <div class="visual-container">
        <div class="device-frame">
          <!-- <DeviceMockup type="laptop" className="hero-device">-->
             <!-- <div class="visual-card card" style="margin-top: 2rem;"> -->
              <!-- <div class="visual-image-wrapper">-->
                <img 
                  src="../images/hero/gya_hero.png" 
                  alt="Professional beauty clinic consultation" 
                  class="visual-image"
                  loading="lazy"
                />
                <!--<div class="visual-overlay"></div> -->
              <!--</div> -->
            <!-- </div> -->
            <!--<MockupContent />-->
         <!-- </DeviceMockup> -->
        </div>
        
        <div class="info-card card-rating">
          <div class="card-header">
            <div class="card-icon-wrapper">
              <span class="card-icon">★★★★★</span>
            </div>
            <span class="card-badge">Verified</span>
          </div>
          <div class="card-body">
            <div class="card-value">5.0</div>
            <div class="card-label">10 Reviews</div>
          </div>
        </div>
        
        <!--<div class="info-card card-certified">
