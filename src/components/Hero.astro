---
import DeviceMockup from './DeviceMockup.astro';
import MockupContent from './MockupContent.astro';

interface Props {
  title: string;
  subtitle: string;
  subtitle2: string;
  subtitle3: string;
  ctaText?: string;
  ctaLink?: string;
  secondaryCtaText?: string;
  secondaryCtaLink?: string;
}

const { 
  title, 
  subtitle,
  subtitle2,
  subtitle3,
  ctaText = "Book Free Consultation",
  ctaLink = "/booking",
  secondaryCtaText = "Explore Treatments",
  secondaryCtaLink = "#"
