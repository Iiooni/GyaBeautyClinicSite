---
const currentYear = new Date().getFullYear();

const footerLinks = {
  company: [
    { name: 'About Us', href: '#' },
    { name: 'Our Team', href: '#' },
   
    { name: 'Press', href: '#' }
  ],
  services: [
    { name: 'Facial Treatments', href: '#' },
    { name: 'Body Treatments', href: '#' },
    { name: 'Anti-Aging', href: '#' }
  ],
  support: [
    { name: 'Contact', href: '#' },
    { name: 'FAQ', href: '/faq' },
    { name: 'Privacy Policy', href: '/privacy' },
    { name: 'Terms of Service', href: '/terms' }
  ]
};

const socialLinks = [
  { name: 'Facebook', href: '#', icon: 'facebook' },
  { name: 'Instagram', href: '#', icon: 'instagram' },
  { name: 'Twitter', href: '#', icon: 'twitter' },
  { name: 'LinkedIn', href: '#', icon: 'linkedin' }
];
---

<footer class="footer">
  <div class="footer-content container">
    <div class="footer-grid">
      <!-- Brand Section -->
      <div class="footer-brand">
        <h3 class="footer-logo">Beauty Clinic</h3>
        <p class="footer-description">
          Transform your beauty journey with our premium treatments and expert care. 
          Your confidence is our passion.
        </p>
        <div class="social-links">
          {socialLinks.map(social => (
            <a href={social.href} class="social-link" aria-label={social.name}>
              {social.icon === 'facebook' && (
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                </svg>
              )}
              {social.icon === 'instagram' && (
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                </svg>
              )}
              {social.icon === 'twitter' && (
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/>
                </svg>
              )}
              {social.icon === 'linkedin' && (
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                </svg>
              )}
            </a>
          ))}
        </div>
      </div>
      
      <!-- Links Sections -->
      <div class="footer-links">
        <h4 class="footer-title">Company</h4>
        <ul class="link-list">
          {footerLinks.company.map(link => (
            <li><a href={link.href}>{link.name}</a></li>
          ))}
        </ul>
      </div>
      
      <div class="footer-links">
        <h4 class="footer-title">Services</h4>
        <ul class="link-list">
          {footerLinks.services.map(link => (
            <li><a href={link.href}>{link.name}</a></li>
          ))}
        </ul>
      </div>
      
      <div class="footer-links">
        <h4 class="footer-title">Support</h4>
        <ul class="link-list">
          {footerLinks.support.map(link => (
            <li><a href={link.href}>{link.name}</a></li>
          ))}
        </ul>
      </div>
      
      <!-- Newsletter -->
      <div class="footer-newsletter">
        <h4 class="footer-title">Newsletter</h4>
        <p class="newsletter-text">Subscribe to get special offers and beauty tips.</p>
        <form class="newsletter-form">
          <input 
            type="email" 
            placeholder="Your email" 
            class="newsletter-input"
            required
          />
          <button type="submit" class="newsletter-btn">Subscribe</button>
        </form>
      </div>
    </div>
    
    <!-- Bottom Bar -->
    <div class="footer-bottom">
      <p class="copyright">
        © {currentYear} GyaAesheticStyle. All rights reserved.
      </p>
      <div class="footer-bottom-links">
        <a href="/privacy">Privacy</a>
        <a href="/terms">Terms</a>
        <a href="/cookies">Cookies</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--bg-secondary);
    border-top: 1px solid var(--border-subtle);
    padding: 6rem 0 2rem;
    position: relative;
  }
  
  /* Subtle depth overlay */
  .footer::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, 
      transparent 0%,
      rgba(236, 72, 153, 0.1) 50%,
      transparent 100%
    );
    pointer-events: none;
  }
  
  .footer-content {
    max-width: 1280px;
  }
  
  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr 1.5fr;
    gap: 3.5rem;
    margin-bottom: 4rem;
    align-items: start;
  }
  
  @media (max-width: 1024px) {
    .footer-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 3rem 2.5rem;
    }
    
    .footer-brand {
      grid-column: span 2;
    }
  }
  
  @media (max-width: 640px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    
    .footer-brand {
      grid-column: span 1;
    }
  }
  
  /* Brand Section */
  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  
  .footer-logo {
    font-family: var(--font-heading);
    font-size: 1.75rem;
    font-weight: 800;
    margin: 0;
    background: linear-gradient(135deg, var(--color-primary-500), var(--color-secondary-500));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    line-height: 1.2;
  }
  
  .footer-description {
    color: var(--text-secondary);
    line-height: 1.7;
    font-size: 0.9375rem;
    opacity: var(--text-opacity-secondary);
    max-width: 320px;
    margin-bottom: 0.25rem;
  }
  
  [data-theme="dark"] .footer-description {
    opacity: var(--text-opacity-secondary);
  }
  
  /* Social Links */
  .social-links {
    display: flex;
    gap: 0.75rem;
  }
  
  .social-link {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 0.75rem;
    background: var(--bg-tertiary);
    color: var(--text-secondary);
    transition: all var(--transition-base);
    border: 1px solid var(--border-subtle);
  }
  
  .social-link:hover {
    background: var(--color-primary-500);
    color: white;
    transform: translateY(-2px);
    box-shadow: var(--shadow-sm);
    border-color: var(--color-primary-500);
  }
  
  [data-theme="dark"] .social-link:hover {
    box-shadow: var(--shadow-sm), var(--shadow-glow-primary);
  }
  
  /* Links Sections */
  .footer-links {
    display: flex;
    flex-direction: column;
  }
  
  .footer-title {
    font-size: 1rem;
    font-weight: 700;
    margin: 0 0 1.25rem 0;
    color: var(--text-primary);
    letter-spacing: -0.01em;
  }
  
  .link-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }
  
  .link-list li {
    line-height: 1;
  }
  
  .link-list a {
    color: var(--text-secondary);
    transition: all var(--transition-base);
    font-size: 0.9375rem;
    display: inline-block;
    opacity: var(--text-opacity-secondary);
    position: relative;
  }
  
  .link-list a::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 1px;
    background: var(--color-primary-500);
    transition: width var(--transition-base);
  }
  
  .link-list a:hover {
    color: var(--color-primary-600);
    opacity: 1;
  }
  
  .link-list a:hover::after {
    width: 100%;
  }
  
  [data-theme="dark"] .link-list a {
    opacity: var(--text-opacity-secondary);
  }
  
  [data-theme="dark"] .link-list a:hover {
    color: var(--color-primary-400);
    opacity: 1;
  }
  
  [data-theme="dark"] .link-list a::after {
    background: var(--color-primary-400);
  }
  
  /* Newsletter Section */
  .footer-newsletter {
    display: flex;
    flex-direction: column;
  }
  
  .newsletter-text {
    color: var(--text-secondary);
    margin: 0 0 1.5rem 0;
    font-size: 0.9375rem;
    line-height: 1.6;
    opacity: var(--text-opacity-secondary);
  }
  
  [data-theme="dark"] .newsletter-text {
    opacity: var(--text-opacity-secondary);
  }
  
  .newsletter-form {
    display: flex;
    gap: 0.5rem;
    align-items: stretch;
  }
  
  .newsletter-input {
    flex: 1;
    padding: 0.75rem 1rem;
    border: 1px solid var(--border-color);
    border-radius: 0.75rem;
    background: var(--bg-tertiary);
    color: var(--text-primary);
    font-size: 0.9375rem;
    transition: all var(--transition-base);
    height: 44px;
    line-height: 1;
  }
  
  .newsletter-input::placeholder {
    color: var(--text-tertiary);
    opacity: var(--text-opacity-muted);
  }
  
  .newsletter-input:focus {
    outline: none;
    border-color: var(--color-primary-500);
    box-shadow: 0 0 0 3px rgba(236, 72, 153, 0.1);
  }
  
  [data-theme="dark"] .newsletter-input:focus {
    box-shadow: 0 0 0 3px rgba(236, 72, 153, 0.15);
  }
  
  .newsletter-btn {
    padding: 0.75rem 1.5rem;
    background: var(--color-primary-500);
    color: white;
    border: none;
    border-radius: 0.75rem;
    font-weight: 600;
    font-size: 0.9375rem;
    cursor: pointer;
    transition: all var(--transition-base);
    white-space: nowrap;
    height: 44px;
    line-height: 1;
    box-shadow: var(--shadow-sm);
  }
  
  .newsletter-btn:hover {
    background: var(--color-primary-600);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }
  
  [data-theme="dark"] .newsletter-btn {
    box-shadow: var(--shadow-sm);
  }
  
  [data-theme="dark"] .newsletter-btn:hover {
    box-shadow: var(--shadow-md), var(--shadow-glow-primary);
  }
  
  /* Footer Bottom */
  .footer-bottom {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-top: 2rem;
    border-top: 1px solid var(--border-subtle);
  }
  
  @media (max-width: 640px) {
    .footer-bottom {
      flex-direction: column;
      gap: 1.25rem;
      text-align: center;
    }
  }
  
  .copyright {
    color: var(--text-secondary);
    font-size: 0.875rem;
    margin: 0;
    opacity: var(--text-opacity-secondary);
    line-height: 1;
  }
  
  [data-theme="dark"] .copyright {
    opacity: var(--text-opacity-secondary);
  }
  
  .footer-bottom-links {
    display: flex;
    gap: 2rem;
    align-items: center;
  }
  
  @media (max-width: 640px) {
    .footer-bottom-links {
      gap: 1.5rem;
    }
  }
  
  .footer-bottom-links a {
    color: var(--text-secondary);
    font-size: 0.875rem;
    transition: all var(--transition-base);
    opacity: var(--text-opacity-secondary);
    position: relative;
    line-height: 1;
  }
  
  .footer-bottom-links a::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 1px;
    background: var(--color-primary-500);
    transition: width var(--transition-base);
  }
  
  .footer-bottom-links a:hover {
    color: var(--color-primary-600);
    opacity: 1;
  }
  
  .footer-bottom-links a:hover::after {
    width: 100%;
  }
  
  [data-theme="dark"] .footer-bottom-links a {
    opacity: var(--text-opacity-secondary);
  }
  
  [data-theme="dark"] .footer-bottom-links a:hover {
    color: var(--color-primary-400);
    opacity: 1;
  }
  
  [data-theme="dark"] .footer-bottom-links a::after {
    background: var(--color-primary-400);
  }
</style>
