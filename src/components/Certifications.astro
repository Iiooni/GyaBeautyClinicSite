---
<style>
    @import '../styles/homepage.css';
</style>



<section class="certifications-section">
    <div class="cerifications-header">
         <h2> Certifications </h2>
         <p class="certifications-subtitle">Subtitle certifications</p>
    </div>
    <div class="certifications-grid">
        <img src="/images/cerfifications/BCAM.png" alt="British College Aesthetic Medicine">
