        <img src="/images/cerfifications/cpd.png" alt="cpd">
    </div>
</section> 



<style>
.certifications-section{
    padding: 5rem 1.5rem;
    max-width: 1600px;
    margin: 0 auto;
}
.cerifications-header{
    max-width: 720px;
    margin-bottom: 2.5rem;
    margin: 0 auto;
    text-align: center;
}
h2{
    color: var(--text-secondary);
    font-size: clamp(2rem, 5vw, 3.2rem);
    font-weight: var(--font-extrabold);
    line-height: 1.1;
}
.certifications-subtitle{
    font-size: clamp(1rem, 2vw, 1.25rem);
    color: var(--text-secondary);
    max-width: 700px;
    margin: 0 auto;
    line-height: 1.7;
}
.certifications-grid{
    display: flex;
    justify-content: space-between;
}
.certifications-grid img{
    height: 5.2rem;
    filter: brightness(0);
    opacity: 50%;
    margin-top: 4rem;
}
